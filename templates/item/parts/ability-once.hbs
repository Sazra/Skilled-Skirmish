{{!--
  The fields of a Class/Species ability of the type "once" (Aktiv, einmaliger
  Effekt) - rendered inside class.hbs/species.hbs's ability loop.
  Context: entry, index, spellName, recoveryModeChoices, recoveryUnitChoices,
  hasActor, statusLabel, actionLabel, itemId. See data/abilityOnce.mjs.
--}}
{{#if (eq entry.type "once")}}
<div class="grid grid-4col">
  <div class="grid-span-1">
    <label class="resource-label">{{localize 'SKSK.Ability.ApCost'}}</label>
    <input type="text" name="system.abilities.{{index}}.apCost" value="{{entry.apCost}}" data-dtype="Number" />
  </div>
  <div class="grid-span-1">
    <label class="resource-label">{{localize 'SKSK.Ability.RpCost'}}</label>
    <input type="text" name="system.abilities.{{index}}.rpCost" value="{{entry.rpCost}}" data-dtype="Number" />
  </div>
  <div class="grid-span-1">
    <label class="resource-label">{{localize 'SKSK.Ability.ManaCost'}}</label>
    <input type="text" name="system.abilities.{{index}}.manaCost" value="{{entry.manaCost}}" data-dtype="Number" />
  </div>
  <div class="grid-span-1">
    <label class="resource-label">{{localize 'SKSK.Ability.Cooldown'}}</label>
    <input type="text" name="system.abilities.{{index}}.cooldownRounds" value="{{entry.cooldownRounds}}" data-dtype="Number" />
  </div>
</div>

<label class="resource-label" title="{{localize 'SKSK.Ability.Once.EffectSpellHint'}}">{{localize 'SKSK.Ability.Once.EffectSpell'}}</label>
<div class="ability-spell-drop" title="{{localize 'SKSK.Ability.Once.EffectSpellHint'}}">
  <input type="text" name="system.abilities.{{index}}.effectSpellUuid" value="{{entry.effectSpellUuid}}"
    placeholder="{{localize 'SKSK.Ability.Once.EffectSpellPlaceholder'}}" />
  {{#if spellName}}<span class="ability-spell-name"><i class="fas fa-wand-sparkles"></i> {{spellName}}</span>{{/if}}
</div>

<label class="resource-label" title="{{localize 'SKSK.Ability.Charges.FormulaHint'}}">{{localize 'SKSK.Ability.Charges.Formula'}}</label>
<input type="text" name="system.abilities.{{index}}.chargesFormula" value="{{entry.chargesFormula}}"
  title="{{localize 'SKSK.Ability.Charges.FormulaHint'}}" placeholder="{{localize 'SKSK.Ability.Charges.FormulaPlaceholder'}}" />
<label class="resource-label" title="{{localize 'SKSK.Ability.Reaction.Hint'}}">{{localize 'SKSK.Ability.Reaction.Title'}}</label>
<div class="grid grid-2col">
  <div class="grid-span-1">
    <label class="resource-label">{{localize 'SKSK.Ability.Reaction.TriggerLabel'}}</label>
    <select name="system.abilities.{{index}}.reaction.trigger">
      {{selectOptions reactionChoices.trigger selected=entry.reaction.trigger localize=true}}
    </select>
  </div>
  <div class="grid-span-1">
    <label class="resource-label">{{localize 'SKSK.Ability.Reaction.EffectLabel'}}</label>
    <select name="system.abilities.{{index}}.reaction.effect">
      {{selectOptions reactionChoices.effect selected=entry.reaction.effect localize=true}}
    </select>
  </div>
</div>
{{#unless (eq entry.reaction.trigger "none")}}
<label class="resource-label">{{localize 'SKSK.Ability.Reaction.Kinds'}}</label>
<div class="flexrow">
  <label class="checkbox"><input type="checkbox" name="system.abilities.{{index}}.reaction.kinds.martialArts" {{checked entry.reaction.kinds.martialArts}} /> {{localize 'SKSK.Ability.Reaction.Kind.martialArts'}}</label>
  <label class="checkbox"><input type="checkbox" name="system.abilities.{{index}}.reaction.kinds.meleeWeapon" {{checked entry.reaction.kinds.meleeWeapon}} /> {{localize 'SKSK.Ability.Reaction.Kind.meleeWeapon'}}</label>
  <label class="checkbox"><input type="checkbox" name="system.abilities.{{index}}.reaction.kinds.rangedWeapon" {{checked entry.reaction.kinds.rangedWeapon}} /> {{localize 'SKSK.Ability.Reaction.Kind.rangedWeapon'}}</label>
  <label class="checkbox"><input type="checkbox" name="system.abilities.{{index}}.reaction.kinds.spell" {{checked entry.reaction.kinds.spell}} /> {{localize 'SKSK.Ability.Reaction.Kind.spell'}}</label>
</div>
{{#if (eq entry.reaction.effect "followUp")}}
<div class="grid grid-3col">
  <div class="grid-span-1">
    <label class="resource-label">{{localize 'SKSK.Ability.Reaction.FollowUpCount'}}</label>
    <input type="text" name="system.abilities.{{index}}.reaction.followUpCount" value="{{entry.reaction.followUpCount}}" data-dtype="Number" />
  </div>
  <div class="grid-span-1">
    <label class="checkbox"><input type="checkbox" name="system.abilities.{{index}}.reaction.followUpFree" {{checked entry.reaction.followUpFree}} /> {{localize 'SKSK.Ability.Reaction.FollowUpFree'}}</label>
  </div>
  <div class="grid-span-1">
    <label class="checkbox"><input type="checkbox" name="system.abilities.{{index}}.reaction.followUpNoCrit" {{checked entry.reaction.followUpNoCrit}} /> {{localize 'SKSK.Ability.Reaction.FollowUpNoCrit'}}</label>
  </div>
</div>
{{/if}}
{{/unless}}

{{#if entry.chargesFormula}}
<label class="resource-label" title="{{localize 'SKSK.Ability.Charges.RecoveryHint'}}">
  {{localize 'SKSK.Ability.Charges.Recovery'}}
  <a class="item-control item-create" data-action="addAbilityChargeRecovery" data-parent-index="{{index}}"
    title="{{localize 'SKSK.Ability.Charges.AddRecovery'}}"><i class="fas fa-plus"></i></a>
</label>
<ol class="items-list items-list-compact">
  {{#each entry.chargeRecovery as |rec ri|}}
  <li class="item flexrow">
    <div class="item-name">
      <select name="system.abilities.{{../index}}.chargeRecovery.{{ri}}.mode">
        {{selectOptions ../recoveryModeChoices selected=rec.mode localize=true}}
      </select>
    </div>
    {{#if (or (eq rec.mode "segments") (eq rec.mode "time"))}}
    <div class="item-name">
      <input type="text" name="system.abilities.{{../index}}.chargeRecovery.{{ri}}.interval" value="{{rec.interval}}"
        data-dtype="Number" title="{{localize 'SKSK.Ability.Charges.Interval'}}" />
    </div>
    {{/if}}
    {{#if (eq rec.mode "time")}}
    <div class="item-name">
      <select name="system.abilities.{{../index}}.chargeRecovery.{{ri}}.unit">
        {{selectOptions ../recoveryUnitChoices selected=rec.unit localize=true}}
      </select>
    </div>
    {{/if}}
    <div class="item-name">
      <input type="text" name="system.abilities.{{../index}}.chargeRecovery.{{ri}}.amountFormula" value="{{rec.amountFormula}}"
        title="{{localize 'SKSK.Ability.Charges.AmountHint'}}" placeholder="1" />
    </div>
    <div class="item-controls">
      <a class="item-control item-delete" data-action="removeNestedArrayEntry" data-parent-field="abilities"
        data-parent-index="{{../index}}" data-field="chargeRecovery" data-index="{{ri}}"><i class="fas fa-trash"></i></a>
    </div>
  </li>
  {{/each}}
</ol>
{{/if}}

{{#if hasActor}}
<div class="flexrow flex-center action-row-controls">
  <span class="ap-cost-label">{{statusLabel}}</span>
  <button type="button" data-action="toggleClassSpeciesAbility" data-item-id="{{itemId}}" data-index="{{index}}">
    {{localize actionLabel}}
  </button>
</div>
{{/if}}
{{/if}}

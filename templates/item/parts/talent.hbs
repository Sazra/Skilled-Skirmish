<section class="tab {{tab.cssClass}}" data-group="primary" data-tab="attributes">

  <div class="resource">
    <label class="resource-label">Talent Type</label>
    <select name="system.talentType">
      {{selectOptions talentTypeChoices selected=system.talentType localize=true}}
    </select>
  </div>

  <div class="resource">
    <label class="resource-label">Attribute Bonuses</label>
    <ol class="items-list">
      <li class="item flexrow items-header">
        <div class="item-name">{{localize 'SKSK.General.Attribute'}}</div>
        <div class="item-name">Bonus</div>
        <div class="item-controls">
          <a class="item-control item-create" data-action="addAttributeBonus" title="Add attribute bonus">
            <i class="fas fa-plus"></i>
          </a>
        </div>
      </li>
      {{#each system.attributeBonuses as |entry index|}}
      <li class="item flexrow">
        <div class="item-name">
          <select name="system.attributeBonuses.{{index}}.attribute">
            {{selectOptions ../attributeChoices selected=entry.attribute localize=true}}
          </select>
        </div>
        <div class="item-name">
          <input type="text" name="system.attributeBonuses.{{index}}.bonus" value="{{entry.bonus}}"
            data-dtype="Number" />
        </div>
        <div class="item-controls">
          <a class="item-control item-delete" data-action="removeArrayEntry" data-field="attributeBonuses"
            data-index="{{index}}" title="Remove">
            <i class="fas fa-trash"></i>
          </a>
        </div>
      </li>
      {{/each}}
    </ol>
  </div>

  <div class="resource">
    <label class="resource-label">Skill Bonuses</label>
    <ol class="items-list">
      <li class="item flexrow items-header">
        <div class="item-name">{{localize 'SKSK.General.Skill'}}</div>
        <div class="item-name">Bonus</div>
        <div class="item-controls">
          <a class="item-control item-create" data-action="addSkillBonus" title="Add skill bonus">
            <i class="fas fa-plus"></i>
          </a>
        </div>
      </li>
      {{#each system.skillBonuses as |entry index|}}
      <li class="item flexrow">
        <div class="item-name">
          <select name="system.skillBonuses.{{index}}.skill">
            {{selectOptions ../skillBonusChoices selected=entry.skill localize=true}}
          </select>
        </div>
        <div class="item-name">
          <input type="text" name="system.skillBonuses.{{index}}.bonus" value="{{entry.bonus}}"
            data-dtype="Number" />
        </div>
        <div class="item-controls">
          <a class="item-control item-delete" data-action="removeArrayEntry" data-field="skillBonuses"
            data-index="{{index}}" title="Remove">
            <i class="fas fa-trash"></i>
          </a>
        </div>
      </li>
      {{/each}}
    </ol>
  </div>

  <div class="resource">
    <label class="resource-label">Ability</label>
    <textarea name="system.ability" rows="4" placeholder="Describe the ability">{{system.ability}}</textarea>
    <label class="resource-label">{{localize 'SKSK.Ability.LifeBonusFormula'}}</label>
    <input type="text" name="system.lifeBonusFormula" value="{{system.lifeBonusFormula}}"
      title="{{localize 'SKSK.Ability.LifeBonusFormulaHint'}}" placeholder="0" />
    <label class="resource-label">{{localize 'SKSK.Ability.ManaBonusFormula'}}</label>
    <input type="text" name="system.manaBonusFormula" value="{{system.manaBonusFormula}}"
      title="{{localize 'SKSK.Ability.ManaBonusFormulaHint'}}" placeholder="0" />

    <ol class="items-list ability-effects">
      {{#each talentEffects as |effect|}}
      <li class="item effect flexrow" data-effect-id="{{effect.id}}">
        <div class="item-name effect-name flexrow">
          <img class="item-image" src="{{effect.img}}" />
          <h4>{{effect.name}}</h4>
        </div>
        <div class="item-controls effect-controls flexrow">
          <a class="effect-control" data-action="toggle" title="{{localize 'SKSK.Effect.Toggle'}}">
            <i class="fas {{#if effect.disabled}}fa-check{{else}}fa-times{{/if}}"></i>
          </a>
          <a class="effect-control" data-action="edit" title="{{localize 'DOCUMENT.Update' type='Effect'}}">
            <i class="fas fa-edit"></i>
          </a>
          <a class="effect-control" data-action="delete" title="{{localize 'DOCUMENT.Delete' type='Effect'}}">
            <i class="fas fa-trash"></i>
          </a>
        </div>
      </li>
      {{/each}}
      <li class="item flexrow">
        <a class="item-control item-create" data-action="create" title="Add effect">
          <i class="fas fa-plus"></i> Add Effect
        </a>
      </li>
    </ol>
  </div>


</section>

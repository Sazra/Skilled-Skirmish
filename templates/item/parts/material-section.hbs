<div class="resource">
  <label class="resource-label">{{localize 'SKSK.Materials.Material'}}</label>
  <select name="system.material">
    <option value="">{{localize 'SKSK.Materials.NoMaterial'}}</option>
    {{#each materials as |material|}}
    <option value="{{material.name}}" {{#if (eq material.name ../system.material)}}selected{{/if}}>{{material.name}}</option>
    {{/each}}
  </select>

  <div class="grid grid-3col">
    {{#if showAttackBonus}}
    <div class="grid-span-1">
      <label class="resource-label">{{localize 'SKSK.Materials.AttackBonus'}}</label>
      <span>{{materialAttackBonus}}</span>
    </div>
    <div class="grid-span-1">
      <label class="resource-label">{{localize 'SKSK.Materials.DamageBonus'}}</label>
      <span>{{materialDamageBonus}}</span>
    </div>
    {{/if}}
    {{#if showArmorBonus}}
    <div class="grid-span-1">
      <label class="resource-label">{{localize 'SKSK.Materials.ArmorBonus'}}</label>
      <span>{{materialArmorBonus}}</span>
    </div>
    {{/if}}
    {{#if showRollBonus}}
    <div class="grid-span-1">
      <label class="resource-label">{{localize 'SKSK.Materials.RollBonus'}}</label>
      <span>{{materialRollBonus}}</span>
    </div>
    {{/if}}
    <div class="grid-span-1">
      <label class="resource-label">{{localize 'SKSK.Materials.TotalManaCapacity'}}</label>
      <span>{{totalManaCapacity}}</span>
    </div>
  </div>
</div>

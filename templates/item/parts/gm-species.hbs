<section class="tab {{tab.cssClass}}" data-group="primary" data-tab="gm">
  <div class="resource">
    <label class="resource-label">Combined School Overrides</label>
    <ol class="items-list items-list-compact">
      <li class="item flexrow items-header">
        <div class="item-name">{{localize 'SKSK.General.School'}}</div>
        <div class="item-name">Base Formula</div>
        <div class="item-controls">
          <a class="item-control item-create" data-action="addCombinedSchoolOverride"
            title="Add combined school override">
            <i class="fas fa-plus"></i>
          </a>
        </div>
      </li>
      {{#each system.combinedSchoolOverrides as |entry index|}}
      <li class="item expandable-item">
        <div class="flexrow">
          <div class="item-name">
            <select name="system.combinedSchoolOverrides.{{index}}.combinedSchool">
              {{selectOptions ../combinedSchoolChoices selected=entry.combinedSchool localize=true}}
            </select>
          </div>
          <div class="item-name">
            <input type="text" name="system.combinedSchoolOverrides.{{index}}.baseFormula"
              value="{{entry.baseFormula}}" placeholder="e.g. L / 2" />
          </div>
          {{#if ../combinedSchoolOverrideValues}}
          <div class="item-name computed-total">= {{lookup ../combinedSchoolOverrideValues index}}</div>
          {{/if}}
          <div class="item-controls">
            <a class="item-control item-delete" data-action="removeArrayEntry" data-field="combinedSchoolOverrides"
              data-index="{{index}}" title="Remove">
              <i class="fas fa-trash"></i>
            </a>
          </div>
        </div>

        <div class="bonus-groups">
          <div class="bonus-group">
            <label class="resource-label">Attribute Bonuses</label>
            <ol class="items-list items-list-compact">
              {{#each entry.attributeBonuses as |bonus bonusIndex|}}
              <li class="item flexrow">
                <div class="item-name">
                  <select name="system.combinedSchoolOverrides.{{index}}.attributeBonuses.{{bonusIndex}}.attribute">
                    {{selectOptions ../../attributeChoices selected=bonus.attribute localize=true}}
                  </select>
                </div>
                <div class="item-name">
                  <label class="casting-method-option">
                    <input type="checkbox"
                      name="system.combinedSchoolOverrides.{{index}}.attributeBonuses.{{bonusIndex}}.useModifier"
                      {{checked bonus.useModifier}} />
                    Modifier
                  </label>
                </div>
                <div class="item-name">
                  <input type="text"
                    name="system.combinedSchoolOverrides.{{index}}.attributeBonuses.{{bonusIndex}}.formula"
                    value="{{bonus.formula}}" placeholder="@value" />
                </div>
                <div class="item-controls">
                  <a class="item-control item-delete" data-action="removeNestedArrayEntry"
                    data-parent-field="combinedSchoolOverrides" data-parent-index="{{index}}"
                    data-field="attributeBonuses" data-index="{{bonusIndex}}" title="Remove">
                    <i class="fas fa-trash"></i>
                  </a>
                </div>
              </li>
              {{/each}}
              <li class="item flexrow">
                <div class="item-controls">
                  <a class="item-control item-create" data-action="addCombinedSchoolOverrideAttributeBonus"
                    data-index="{{index}}" title="Add attribute bonus">
                    <i class="fas fa-plus"></i> Add
                  </a>
                </div>
              </li>
            </ol>
          </div>

          <div class="bonus-group">
            <label class="resource-label">Skill Bonuses</label>
            <ol class="items-list items-list-compact">
              {{#each entry.skillBonuses as |bonus bonusIndex|}}
              <li class="item flexrow">
                <div class="item-name">
                  <select name="system.combinedSchoolOverrides.{{index}}.skillBonuses.{{bonusIndex}}.skill">
                    {{selectOptions ../../skillBonusChoices selected=bonus.skill localize=true}}
                  </select>
                </div>
                <div class="item-name">
                  <input type="text"
                    name="system.combinedSchoolOverrides.{{index}}.skillBonuses.{{bonusIndex}}.formula"
                    value="{{bonus.formula}}" placeholder="@value" />
                </div>
                <div class="item-controls">
                  <a class="item-control item-delete" data-action="removeNestedArrayEntry"
                    data-parent-field="combinedSchoolOverrides" data-parent-index="{{index}}"
                    data-field="skillBonuses" data-index="{{bonusIndex}}" title="Remove">
                    <i class="fas fa-trash"></i>
                  </a>
                </div>
              </li>
              {{/each}}
              <li class="item flexrow">
                <div class="item-controls">
                  <a class="item-control item-create" data-action="addCombinedSchoolOverrideSkillBonus"
                    data-index="{{index}}" title="Add skill bonus">
                    <i class="fas fa-plus"></i> Add
                  </a>
                </div>
              </li>
            </ol>
          </div>
        </div>
      </li>
      {{/each}}
    </ol>
  </div>

  <div class="resource">
    <label class="resource-label">Mana Cost Reductions</label>
    <ol class="items-list items-list-compact">
      <li class="item flexrow items-header">
        <div class="item-name">{{localize 'SKSK.General.Type'}}</div>
        <div class="item-name">{{localize 'SKSK.General.School'}}</div>
        <div class="item-name">%</div>
        <div class="item-name">Flat</div>
        <div class="item-name">Below 1?</div>
        <div class="item-controls">
          <a class="item-control item-create" data-action="addManaCostReduction" title="Add mana cost reduction">
            <i class="fas fa-plus"></i>
          </a>
        </div>
      </li>
      {{#each system.manaCostReductions as |entry index|}}
      <li class="item flexrow">
        <div class="item-name">
          <select name="system.manaCostReductions.{{index}}.spellType">
            {{selectOptions ../spellTypeChoices selected=entry.spellType localize=true}}
          </select>
        </div>
        <div class="item-name">
          {{#if (eq entry.spellType "simple")}}
          <select name="system.manaCostReductions.{{index}}.school">
            {{selectOptions ../simpleMagicSchoolChoices selected=entry.school localize=true}}
          </select>
          {{else if (eq entry.spellType "advanced")}}
          <select name="system.manaCostReductions.{{index}}.school">
            {{selectOptions ../advancedMagicSchoolChoices selected=entry.school localize=true}}
          </select>
          {{else if (eq entry.spellType "combined")}}
          <select name="system.manaCostReductions.{{index}}.school">
            {{selectOptions ../combinedSchoolChoices selected=entry.school localize=true}}
          </select>
          {{else}}
          <select name="system.manaCostReductions.{{index}}.school">
            {{selectOptions ../systemlessCategoryChoices selected=entry.school localize=true}}
          </select>
          {{/if}}
        </div>
        <div class="item-name">
          <input type="text" name="system.manaCostReductions.{{index}}.percent" value="{{entry.percent}}"
            data-dtype="Number" />
        </div>
        <div class="item-name">
          <input type="text" name="system.manaCostReductions.{{index}}.flatFormula" value="{{entry.flatFormula}}"
            placeholder="e.g. L" />
        </div>
        <div class="item-name">
          <input type="checkbox" name="system.manaCostReductions.{{index}}.allowBelowOne"
            {{checked entry.allowBelowOne}} title="This entry's flat reduction can push the cost below 1 (down to 0)" />
        </div>
        <div class="item-controls">
          <a class="item-control item-delete" data-action="removeArrayEntry" data-field="manaCostReductions"
            data-index="{{index}}" title="Remove">
            <i class="fas fa-trash"></i>
          </a>
        </div>
      </li>
      {{/each}}
    </ol>
  </div>

  <div class="resource">
    <label class="resource-label">AP Cost Reductions</label>
    <ol class="items-list items-list-compact">
      <li class="item flexrow items-header">
        <div class="item-name">{{localize 'SKSK.General.Type'}}</div>
        <div class="item-name">{{localize 'SKSK.General.School'}}</div>
        <div class="item-name">Flat</div>
        <div class="item-controls">
          <a class="item-control item-create" data-action="addApCostReduction" title="Add AP cost reduction">
            <i class="fas fa-plus"></i>
          </a>
        </div>
      </li>
      {{#each system.apCostReductions as |entry index|}}
      <li class="item flexrow">
        <div class="item-name">
          <select name="system.apCostReductions.{{index}}.spellType">
            {{selectOptions ../spellTypeChoices selected=entry.spellType localize=true}}
          </select>
        </div>
        <div class="item-name">
          {{#if (eq entry.spellType "simple")}}
          <select name="system.apCostReductions.{{index}}.school">
            {{selectOptions ../simpleMagicSchoolChoices selected=entry.school localize=true}}
          </select>
          {{else if (eq entry.spellType "advanced")}}
          <select name="system.apCostReductions.{{index}}.school">
            {{selectOptions ../advancedMagicSchoolChoices selected=entry.school localize=true}}
          </select>
          {{else if (eq entry.spellType "combined")}}
          <select name="system.apCostReductions.{{index}}.school">
            {{selectOptions ../combinedSchoolChoices selected=entry.school localize=true}}
          </select>
          {{else}}
          <select name="system.apCostReductions.{{index}}.school">
            {{selectOptions ../systemlessCategoryChoices selected=entry.school localize=true}}
          </select>
          {{/if}}
        </div>
        <div class="item-name">
          <input type="text" name="system.apCostReductions.{{index}}.flatFormula" value="{{entry.flatFormula}}"
            placeholder="e.g. L" />
        </div>
        <div class="item-controls">
          <a class="item-control item-delete" data-action="removeArrayEntry" data-field="apCostReductions"
            data-index="{{index}}" title="Remove">
            <i class="fas fa-trash"></i>
          </a>
        </div>
      </li>
      {{/each}}
    </ol>
  </div>

  <div class="resource">
    <label class="resource-label">Movement Bonuses</label>
    <ol class="items-list items-list-compact">
      <li class="item flexrow items-header">
        <div class="item-name">{{localize 'SKSK.General.Type'}}</div>
        <div class="item-name">{{localize 'SKSK.Movement.Mode.Label'}}</div>
        <div class="item-name">Bonus</div>
        <div class="item-name" title="{{localize 'SKSK.Movement.UnlockedHint'}}">
          {{localize 'SKSK.Movement.Unlocked'}}
        </div>
        <div class="item-controls">
          <a class="item-control item-create" data-action="addMovementBonus" title="Add movement bonus">
            <i class="fas fa-plus"></i>
          </a>
        </div>
      </li>
      {{#each system.movementBonuses as |entry index|}}
      <li class="item flexrow">
        <div class="item-name">
          <select name="system.movementBonuses.{{index}}.movementType">
            {{selectOptions ../movementTypeChoices selected=entry.movementType localize=true}}
          </select>
        </div>
        <div class="item-name">
          <select name="system.movementBonuses.{{index}}.mode">
            {{selectOptions ../movementBonusModeChoices selected=entry.mode localize=true}}
          </select>
        </div>
        <div class="item-name">
          <input type="text" name="system.movementBonuses.{{index}}.bonus" value="{{entry.bonus}}"
            data-dtype="Number" />
        </div>
        <div class="item-name">
          <input type="checkbox" name="system.movementBonuses.{{index}}.unlocked" {{checked entry.unlocked}}
            title="{{localize 'SKSK.Movement.UnlockedHint'}}" />
        </div>
        <div class="item-controls">
          <a class="item-control item-delete" data-action="removeArrayEntry" data-field="movementBonuses"
            data-index="{{index}}" title="Remove">
            <i class="fas fa-trash"></i>
          </a>
        </div>
      </li>
      {{/each}}
    </ol>
  </div>

  <div class="resource">
    <label class="resource-label">{{localize 'SKSK.GeneralResource.ChargeBonuses'}}</label>
    <ol class="items-list items-list-compact">
      <li class="item flexrow items-header">
        <div class="item-name">{{localize 'SKSK.GeneralResource.Resource'}}</div>
        <div class="item-name">Bonus</div>
        <div class="item-controls">
          <a class="item-control item-create" data-action="addChargeBonus" title="Add charge bonus">
            <i class="fas fa-plus"></i>
          </a>
        </div>
      </li>
      {{#each system.chargeBonuses as |entry index|}}
      <li class="item flexrow">
        <div class="item-name">
          <select name="system.chargeBonuses.{{index}}.resource">
            {{selectOptions ../chargeResourceChoices selected=entry.resource localize=true}}
          </select>
        </div>
        <div class="item-name">
          <input type="text" name="system.chargeBonuses.{{index}}.bonus" value="{{entry.bonus}}"
            data-dtype="Number" />
        </div>
        <div class="item-controls">
          <a class="item-control item-delete" data-action="removeArrayEntry" data-field="chargeBonuses"
            data-index="{{index}}" title="Remove">
            <i class="fas fa-trash"></i>
          </a>
        </div>
      </li>
      {{/each}}
    </ol>
  </div>

  <div class="resource">
    <label class="resource-label">{{localize 'SKSK.AttributeMax.ModifiersLabel'}}</label>
    <ol class="items-list items-list-compact">
      <li class="item flexrow items-header">
        <div class="item-name">{{localize 'SKSK.General.Attribute'}}</div>
        <div class="item-name">Operation</div>
        <div class="item-name">{{localize 'SKSK.General.Value'}}</div>
        <div class="item-controls">
          <a class="item-control item-create" data-action="addAttributeMaxModifier" title="Add attribute max modifier">
            <i class="fas fa-plus"></i>
          </a>
        </div>
      </li>
      {{#each system.attributeMaxModifiers as |entry index|}}
      <li class="item flexrow">
        <div class="item-name">
          <select name="system.attributeMaxModifiers.{{index}}.attribute">
            {{selectOptions ../attributeChoices selected=entry.attribute localize=true}}
          </select>
        </div>
        <div class="item-name">
          <select name="system.attributeMaxModifiers.{{index}}.operation">
            {{selectOptions ../attributeMaxOperationChoices selected=entry.operation localize=true}}
          </select>
        </div>
        <div class="item-name">
          <input type="text" name="system.attributeMaxModifiers.{{index}}.value" value="{{entry.value}}"
            data-dtype="Number" />
        </div>
        <div class="item-controls">
          <a class="item-control item-delete" data-action="removeArrayEntry" data-field="attributeMaxModifiers"
            data-index="{{index}}" title="Remove">
            <i class="fas fa-trash"></i>
          </a>
        </div>
      </li>
      {{/each}}
    </ol>
  </div>
</section>

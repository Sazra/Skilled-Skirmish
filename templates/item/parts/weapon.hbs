<section class="tab {{tab.cssClass}}" data-group="primary" data-tab="attributes">
  <div class="grid grid-3col">
    <div class="grid-span-1">
      <label class="casting-method-option">
        <input type="checkbox" name="system.equipped" {{checked system.equipped}} />
        Equipped
      </label>
    </div>
    <div class="grid-span-1">
      <label class="casting-method-option">
        <input type="checkbox" name="system.enchanted" {{checked system.enchanted}} />
        Enchanted
      </label>
    </div>
    <div class="grid-span-1">
      <label class="resource-label">{{localize 'SKSK.Action.UseApCost'}}</label>
      <input type="text" name="system.useApCost" value="{{system.useApCost}}" data-dtype="Number" />
    </div>
  </div>

  {{> "systems/sksk/templates/item/parts/material-section.hbs" showAttackBonus=true}}

  <div class="grid grid-2col">
    <div class="grid-span-1">
      <label class="resource-label">{{localize 'SKSK.Models.WeaponType'}}</label>
      <select name="system.weaponType">
        {{selectOptions typeChoices selected=system.weaponType localize=true}}
      </select>
    </div>
    <div class="grid-span-1">
      <label class="resource-label">{{localize 'SKSK.Models.Model'}}</label>
      <select name="system.model">
        <option value="">{{localize 'SKSK.Models.NoModel'}}</option>
        {{#each modelChoices as |m|}}
        <option value="{{m.name}}" {{#if (eq m.name ../system.model)}}selected{{/if}}>{{m.name}}</option>
        {{/each}}
      </select>
    </div>
  </div>

  {{#if isRangedWeapon}}
  <div class="grid grid-2col">
    <div class="grid-span-1">
      <label class="resource-label">{{localize 'SKSK.Models.AmmunitionModel'}}</label>
      <select name="system.ammunitionModel">
        <option value="">{{localize 'SKSK.Models.NoModel'}}</option>
        {{#each ammunitionModelChoices as |m|}}
        <option value="{{m.name}}" {{#if (eq m.name ../system.ammunitionModel)}}selected{{/if}}>{{m.name}}</option>
        {{/each}}
      </select>
    </div>
  </div>
  {{/if}}

  {{#if resolvedModel}}
  <div class="grid grid-2col">
    <div class="grid-span-1">
      <label class="resource-label">{{localize 'SKSK.Models.DiceFormula'}}</label>
      <span>{{resolvedModel.diceFormula}}</span>
    </div>
    <div class="grid-span-1">
      <label class="resource-label">{{localize 'SKSK.Models.FlatBonus'}}</label>
      <span>{{resolvedModel.flatBonus}}</span>
    </div>
  </div>
  {{/if}}
  {{#if resolvedAmmunitionModel}}
  <div class="grid grid-2col">
    <div class="grid-span-1">
      <label class="resource-label">{{localize 'SKSK.Models.AmmunitionDiceFormula'}}</label>
      <span>{{resolvedAmmunitionModel.diceFormula}}</span>
    </div>
    <div class="grid-span-1">
      <label class="resource-label">{{localize 'SKSK.Models.AmmunitionFlatBonus'}}</label>
      <span>{{resolvedAmmunitionModel.flatBonus}}</span>
    </div>
  </div>
  {{/if}}
</section>

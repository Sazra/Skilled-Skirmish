<section class="tab {{tab.cssClass}}" data-group="primary" data-tab="attributes">
  <div class="grid grid-3col">
    <div class="grid-span-1">
      <label class="casting-method-option">
        <input type="checkbox" name="system.equippable" {{checked system.equippable}} />
        Equippable
      </label>
    </div>
    {{#if isEquippable}}
    <div class="grid-span-1">
      <label class="casting-method-option">
        <input type="checkbox" name="system.equipped" {{checked system.equipped}} />
        Equipped
      </label>
    </div>
    <div class="grid-span-1">
      <label class="casting-method-option">
        <input type="checkbox" name="system.enchanted" {{checked system.enchanted}} />
        Enchanted
      </label>
    </div>
    {{/if}}
  </div>

  <div class="resource">
    <label class="casting-method-option">
      <input type="checkbox" name="system.consumable" {{checked system.consumable}} />
      Consumable
    </label>
  </div>

  <div class="resource">
    <label class="resource-label">{{localize 'SKSK.Action.UseApCost'}}</label>
    <input type="text" name="system.useApCost" value="{{system.useApCost}}" data-dtype="Number" />
  </div>

  <div class="resource">
    <label class="resource-label" title="{{localize 'SKSK.ItemSheet.ManaCoreFpGrantHint'}}">
      {{localize 'SKSK.ItemSheet.ManaCoreFpGrant'}}
    </label>
    <input type="text" name="system.manaCoreFpGrant" value="{{system.manaCoreFpGrant}}" data-dtype="Number" />
  </div>

  <div class="resource">
    <label class="casting-method-option">
      <input type="checkbox" name="system.charges.enabled" {{checked system.charges.enabled}} />
      {{localize 'SKSK.Charges.Enabled'}}
    </label>
    {{#if system.charges.enabled}}
    <div class="grid grid-2col">
      <div class="grid-span-1">
        <label class="resource-label">{{localize 'SKSK.Charges.Value'}}</label>
        <input type="text" name="system.charges.value" value="{{system.charges.value}}" data-dtype="Number" />
      </div>
      <div class="grid-span-1">
        <label class="resource-label">{{localize 'SKSK.Charges.Max'}}</label>
        <input type="text" name="system.charges.max" value="{{system.charges.max}}" data-dtype="Number" />
      </div>
    </div>
    {{/if}}
  </div>

  {{> "systems/sksk/templates/item/parts/material-section.hbs" showRollBonus=true}}

  <div class="resource">
    <label class="resource-label">Roll Formula:</label>
    <span>{{system.formula}}</span>
    <div class="grid grid-4col">
      <div class="grid-span-1">
        <label class="resource-label">Number of Dice</label>
        <input type="text" name="system.roll.diceNum" value="{{system.roll.diceNum}}" data-dtype="Number" />
      </div>
      <div class="grid-span-1">
        <label class="resource-label">Die Size</label>
        <input type="text" name="system.roll.diceSize" value="{{system.roll.diceSize}}" data-dtype="String" />
      </div>
      <div class="grid-span-2">
        <label class="resource-label">Roll Modifier</label>
        <input type="text" name="system.roll.diceBonus" value="{{system.roll.diceBonus}}" data-dtype="String" />
      </div>
    </div>
  </div>

  <div class="resource">
    <label class="resource-label">Mana Cost Reductions</label>
    <ol class="items-list items-list-compact">
      <li class="item flexrow items-header">
        <div class="item-name">{{localize 'SKSK.General.Type'}}</div>
        <div class="item-name">{{localize 'SKSK.General.School'}}</div>
        <div class="item-name">%</div>
        <div class="item-name">Flat</div>
        <div class="item-name">Below 1?</div>
        <div class="item-controls">
          <a class="item-control item-create" data-action="addManaCostReduction" title="Add mana cost reduction">
            <i class="fas fa-plus"></i>
          </a>
        </div>
      </li>
      {{#each system.manaCostReductions as |entry index|}}
      <li class="item flexrow">
        <div class="item-name">
          <select name="system.manaCostReductions.{{index}}.spellType">
            {{selectOptions ../spellTypeChoices selected=entry.spellType localize=true}}
          </select>
        </div>
        <div class="item-name">
          {{#if (eq entry.spellType "simple")}}
          <select name="system.manaCostReductions.{{index}}.school">
            {{selectOptions ../simpleMagicSchoolChoices selected=entry.school localize=true}}
          </select>
          {{else if (eq entry.spellType "advanced")}}
          <select name="system.manaCostReductions.{{index}}.school">
            {{selectOptions ../advancedMagicSchoolChoices selected=entry.school localize=true}}
          </select>
          {{else if (eq entry.spellType "combined")}}
          <select name="system.manaCostReductions.{{index}}.school">
            {{selectOptions ../combinedSchoolChoices selected=entry.school localize=true}}
          </select>
          {{else}}
          <select name="system.manaCostReductions.{{index}}.school">
            {{selectOptions ../systemlessCategoryChoices selected=entry.school localize=true}}
          </select>
          {{/if}}
        </div>
        <div class="item-name">
          <input type="text" name="system.manaCostReductions.{{index}}.percent" value="{{entry.percent}}"
            data-dtype="Number" />
        </div>
        <div class="item-name">
          <input type="text" name="system.manaCostReductions.{{index}}.flatFormula" value="{{entry.flatFormula}}"
            placeholder="e.g. L" />
        </div>
        <div class="item-name">
          <input type="checkbox" name="system.manaCostReductions.{{index}}.allowBelowOne"
            {{checked entry.allowBelowOne}} title="This entry's flat reduction can push the cost below 1 (down to 0)" />
        </div>
        <div class="item-controls">
          <a class="item-control item-delete" data-action="removeArrayEntry" data-field="manaCostReductions"
            data-index="{{index}}" title="Remove">
            <i class="fas fa-trash"></i>
          </a>
        </div>
      </li>
      {{/each}}
    </ol>
  </div>

  <div class="resource">
    <label class="resource-label">AP Cost Reductions</label>
    <ol class="items-list items-list-compact">
      <li class="item flexrow items-header">
        <div class="item-name">{{localize 'SKSK.General.Type'}}</div>
        <div class="item-name">{{localize 'SKSK.General.School'}}</div>
        <div class="item-name">Flat</div>
        <div class="item-controls">
          <a class="item-control item-create" data-action="addApCostReduction" title="Add AP cost reduction">
            <i class="fas fa-plus"></i>
          </a>
        </div>
      </li>
      {{#each system.apCostReductions as |entry index|}}
      <li class="item flexrow">
        <div class="item-name">
          <select name="system.apCostReductions.{{index}}.spellType">
            {{selectOptions ../spellTypeChoices selected=entry.spellType localize=true}}
          </select>
        </div>
        <div class="item-name">
          {{#if (eq entry.spellType "simple")}}
          <select name="system.apCostReductions.{{index}}.school">
            {{selectOptions ../simpleMagicSchoolChoices selected=entry.school localize=true}}
          </select>
          {{else if (eq entry.spellType "advanced")}}
          <select name="system.apCostReductions.{{index}}.school">
            {{selectOptions ../advancedMagicSchoolChoices selected=entry.school localize=true}}
          </select>
          {{else if (eq entry.spellType "combined")}}
          <select name="system.apCostReductions.{{index}}.school">
            {{selectOptions ../combinedSchoolChoices selected=entry.school localize=true}}
          </select>
          {{else}}
          <select name="system.apCostReductions.{{index}}.school">
            {{selectOptions ../systemlessCategoryChoices selected=entry.school localize=true}}
          </select>
          {{/if}}
        </div>
        <div class="item-name">
          <input type="text" name="system.apCostReductions.{{index}}.flatFormula" value="{{entry.flatFormula}}"
            placeholder="e.g. L" />
        </div>
        <div class="item-controls">
          <a class="item-control item-delete" data-action="removeArrayEntry" data-field="apCostReductions"
            data-index="{{index}}" title="Remove">
            <i class="fas fa-trash"></i>
          </a>
        </div>
      </li>
      {{/each}}
    </ol>
  </div>

  <div class="resource">
    <label class="resource-label">Movement Bonuses</label>
    <ol class="items-list items-list-compact">
      <li class="item flexrow items-header">
        <div class="item-name">{{localize 'SKSK.General.Type'}}</div>
        <div class="item-name">Bonus</div>
        <div class="item-controls">
          <a class="item-control item-create" data-action="addMovementBonus" title="Add movement bonus">
            <i class="fas fa-plus"></i>
          </a>
        </div>
      </li>
      {{#each system.movementBonuses as |entry index|}}
      <li class="item flexrow">
        <div class="item-name">
          <select name="system.movementBonuses.{{index}}.movementType">
            {{selectOptions ../movementTypeChoices selected=entry.movementType localize=true}}
          </select>
        </div>
        <div class="item-name">
          <input type="text" name="system.movementBonuses.{{index}}.bonus" value="{{entry.bonus}}"
            data-dtype="Number" />
        </div>
        <div class="item-controls">
          <a class="item-control item-delete" data-action="removeArrayEntry" data-field="movementBonuses"
            data-index="{{index}}" title="Remove">
            <i class="fas fa-trash"></i>
          </a>
        </div>
      </li>
      {{/each}}
    </ol>
  </div>
</section>

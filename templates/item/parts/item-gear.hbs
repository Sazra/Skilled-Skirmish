<section class="tab {{tab.cssClass}}" data-group="primary" data-tab="attributes">
  <div class="grid grid-3col">
    <div class="grid-span-1">
      <label class="casting-method-option">
        <input type="checkbox" name="system.equippable" {{checked system.equippable}} />
        {{localize 'SKSK.Items.Equippable'}}
      </label>
    </div>
    {{#if isEquippable}}
    <div class="grid-span-1">
      <label class="casting-method-option">
        <input type="checkbox" name="system.equipped" {{checked system.equipped}} />
        {{localize 'SKSK.Items.Equipped'}}
      </label>
    </div>
    <div class="grid-span-1">
      <label class="casting-method-option">
        <input type="checkbox" name="system.enchanted" {{checked system.enchanted}} />
        {{localize 'SKSK.Items.Enchanted'}}
      </label>
    </div>
    {{/if}}
  </div>

  <div class="resource">
    <label class="casting-method-option">
      <input type="checkbox" name="system.consumable" {{checked system.consumable}} />
      {{localize 'SKSK.Items.Consumable'}}
    </label>
  </div>

  {{#if isUsable}}
  <div class="grid grid-2col">
    <div class="grid-span-1">
      <label class="resource-label">{{localize 'SKSK.Action.UseApCost'}}</label>
      <input type="text" name="system.useApCost" value="{{system.useApCost}}" data-dtype="Number" />
    </div>
    <div class="grid-span-1">
      <label class="resource-label">{{localize 'SKSK.Action.UseRpCost'}}</label>
      <input type="text" name="system.useRpCost" value="{{system.useRpCost}}" data-dtype="Number" />
    </div>
  </div>

  <div class="resource">
    <label class="casting-method-option">
      <input type="checkbox" name="system.charges.enabled" {{checked system.charges.enabled}} />
      {{localize 'SKSK.Charges.Enabled'}}
    </label>
    {{#if system.charges.enabled}}
    <div class="grid grid-2col">
      <div class="grid-span-1">
        <label class="resource-label">{{localize 'SKSK.Charges.Value'}}</label>
        <input type="text" name="system.charges.value" value="{{system.charges.value}}" data-dtype="Number" />
      </div>
      <div class="grid-span-1">
        <label class="resource-label">{{localize 'SKSK.Charges.Max'}}</label>
        <input type="text" name="system.charges.max" value="{{system.charges.max}}" data-dtype="Number" />
      </div>
    </div>
    {{/if}}
  </div>

  <div class="resource">
    <label class="casting-method-option">
      <input type="checkbox" name="system.roll.enabled" {{checked system.roll.enabled}} />
      {{localize 'SKSK.ItemSheet.RollEnabled'}}
    </label>
    {{#if system.roll.enabled}}
    <label class="resource-label">{{localize 'SKSK.ItemSheet.RollFormulaLabel'}}</label>
    <span>{{system.formula}}</span>
    <div class="grid grid-4col">
      <div class="grid-span-1">
        <label class="resource-label">{{localize 'SKSK.ItemSheet.DiceNum'}}</label>
        <input type="text" name="system.roll.diceNum" value="{{system.roll.diceNum}}" data-dtype="Number" />
      </div>
      <div class="grid-span-1">
        <label class="resource-label">{{localize 'SKSK.ItemSheet.DiceSize'}}</label>
        <input type="text" name="system.roll.diceSize" value="{{system.roll.diceSize}}" data-dtype="String" />
      </div>
      <div class="grid-span-2">
        <label class="resource-label">{{localize 'SKSK.ItemSheet.DiceBonus'}}</label>
        <input type="text" name="system.roll.diceBonus" value="{{system.roll.diceBonus}}" data-dtype="String" />
      </div>
    </div>
    {{/if}}
  </div>
  {{/if}}

  {{> "systems/sksk/templates/item/parts/material-section.hbs" showRollBonus=true}}

</section>

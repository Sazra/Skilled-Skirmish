<section class="tab {{tab.cssClass}}" data-group="primary" data-tab="gm">
  {{> "systems/sksk/templates/item/parts/material-override-section.hbs"}}

  <details class="model-properties-details" data-sync="weapon-attribute-override">
    <summary class="resource-label">{{localize 'SKSK.Models.AttributeOverride'}}</summary>
    <p class="hint">{{localize 'SKSK.Models.AttributeOverrideHint'}}</p>
    <label class="casting-method-option">
      <input type="checkbox" name="system.attributeOverride.enabled" {{checked system.attributeOverride.enabled}} />
      {{localize 'SKSK.Models.AttributeOverrideEnabled'}}
    </label>
    <div class="grid grid-4col model-checkbox-grid">
      {{#each attributeChoices as |label key|}}
      <label class="casting-method-option">
        <input type="checkbox" name="system.attributeOverride.attributes.{{key}}"
          {{checked (lookup ../system.attributeOverride.attributes key)}} />
        {{localize label}}
      </label>
      {{/each}}
    </div>
  </details>

  <details class="model-properties-details" data-sync="weapon-damage-type-override">
    <summary class="resource-label">{{localize 'SKSK.Models.DamageTypeOverride'}}</summary>
    <p class="hint">{{localize 'SKSK.Models.DamageTypeOverrideHint'}}</p>
    <label class="casting-method-option">
      <input type="checkbox" name="system.damageTypeOverride.enabled" {{checked system.damageTypeOverride.enabled}} />
      {{localize 'SKSK.Models.DamageTypeOverrideEnabled'}}
    </label>
    <select name="system.damageTypeOverride.damageType">
      {{#if isRangedWeapon}}
      {{selectOptions rangedDamageTypeChoices selected=system.damageTypeOverride.damageType localize=true}}
      {{else}}
      {{selectOptions damageTypeChoices selected=system.damageTypeOverride.damageType localize=true}}
      {{/if}}
    </select>
  </details>

  <details class="model-properties-details property-overrides-section" data-sync="weapon-property-overrides">
    <summary class="resource-label">{{localize 'SKSK.Models.PropertyOverrides'}}</summary>
    <div class="grid grid-3col model-checkbox-grid">
      {{#each overridePropertyChoices as |def key|}}
      <div class="model-property-option">
        <label class="casting-method-option" title="{{localize def.hint}}">
          <input type="checkbox" class="property-override-toggle" data-property="{{key}}"
            {{checked (includes ../effectivePropertyKeys key)}} />
          {{localize def.label}}
        </label>
        {{#if def.hasRequirement}}
        <input type="text" class="model-requirement-input property-override-value" data-property="{{key}}"
          value="{{lookup ../effectivePropertyValues key}}" data-dtype="Number"
          title="{{localize 'SKSK.Models.Requirement'}}" placeholder="{{localize 'SKSK.Models.Requirement'}}" />
        {{/if}}
        {{#if def.hasRange}}
        <input type="text" class="model-requirement-input property-override-value" data-property="{{key}}"
          value="{{lookup ../effectivePropertyValues key}}" data-dtype="Number"
          title="{{localize 'SKSK.Models.Range'}}" placeholder="{{localize 'SKSK.Models.Range'}}" />
        {{/if}}
        {{#if def.hasApCost}}
        <input type="text" class="model-requirement-input property-override-value" data-property="{{key}}"
          value="{{lookup ../effectivePropertyValues key}}" data-dtype="Number"
          title="{{localize 'SKSK.Models.ApCost'}}" placeholder="{{localize 'SKSK.Models.ApCost'}}" />
        {{/if}}
      </div>
      {{/each}}
    </div>
  </details>

  <div class="resource">
    <label class="resource-label">Mana Cost Reductions</label>
    <ol class="items-list items-list-compact">
      <li class="item flexrow items-header">
        <div class="item-name">{{localize 'SKSK.General.Type'}}</div>
        <div class="item-name">{{localize 'SKSK.General.School'}}</div>
        <div class="item-name">%</div>
        <div class="item-name">Flat</div>
        <div class="item-name">Below 1?</div>
        <div class="item-controls">
          <a class="item-control item-create" data-action="addManaCostReduction" title="Add mana cost reduction">
            <i class="fas fa-plus"></i>
          </a>
        </div>
      </li>
      {{#each system.manaCostReductions as |entry index|}}
      <li class="item flexrow">
        <div class="item-name">
          <select name="system.manaCostReductions.{{index}}.spellType">
            {{selectOptions ../spellTypeChoices selected=entry.spellType localize=true}}
          </select>
        </div>
        <div class="item-name">
          {{#if (eq entry.spellType "simple")}}
          <select name="system.manaCostReductions.{{index}}.school">
            {{selectOptions ../simpleMagicSchoolChoices selected=entry.school localize=true}}
          </select>
          {{else if (eq entry.spellType "advanced")}}
          <select name="system.manaCostReductions.{{index}}.school">
            {{selectOptions ../advancedMagicSchoolChoices selected=entry.school localize=true}}
          </select>
          {{else if (eq entry.spellType "combined")}}
          <select name="system.manaCostReductions.{{index}}.school">
            {{selectOptions ../combinedSchoolChoices selected=entry.school localize=true}}
          </select>
          {{else}}
          <select name="system.manaCostReductions.{{index}}.school">
            {{selectOptions ../systemlessCategoryChoices selected=entry.school localize=true}}
          </select>
          {{/if}}
        </div>
        <div class="item-name">
          <input type="text" name="system.manaCostReductions.{{index}}.percent" value="{{entry.percent}}"
            data-dtype="Number" />
        </div>
        <div class="item-name">
          <input type="text" name="system.manaCostReductions.{{index}}.flatFormula" value="{{entry.flatFormula}}"
            placeholder="e.g. L" />
        </div>
        <div class="item-name">
          <input type="checkbox" name="system.manaCostReductions.{{index}}.allowBelowOne"
            {{checked entry.allowBelowOne}} title="This entry's flat reduction can push the cost below 1 (down to 0)" />
        </div>
        <div class="item-controls">
          <a class="item-control item-delete" data-action="removeArrayEntry" data-field="manaCostReductions"
            data-index="{{index}}" title="Remove">
            <i class="fas fa-trash"></i>
          </a>
        </div>
      </li>
      {{/each}}
    </ol>
  </div>

  <div class="resource">
    <label class="resource-label">AP Cost Reductions</label>
    <ol class="items-list items-list-compact">
      <li class="item flexrow items-header">
        <div class="item-name">{{localize 'SKSK.General.Type'}}</div>
        <div class="item-name">{{localize 'SKSK.General.School'}}</div>
        <div class="item-name">Flat</div>
        <div class="item-controls">
          <a class="item-control item-create" data-action="addApCostReduction" title="Add AP cost reduction">
            <i class="fas fa-plus"></i>
          </a>
        </div>
      </li>
      {{#each system.apCostReductions as |entry index|}}
      <li class="item flexrow">
        <div class="item-name">
          <select name="system.apCostReductions.{{index}}.spellType">
            {{selectOptions ../spellTypeChoices selected=entry.spellType localize=true}}
          </select>
        </div>
        <div class="item-name">
          {{#if (eq entry.spellType "simple")}}
          <select name="system.apCostReductions.{{index}}.school">
            {{selectOptions ../simpleMagicSchoolChoices selected=entry.school localize=true}}
          </select>
          {{else if (eq entry.spellType "advanced")}}
          <select name="system.apCostReductions.{{index}}.school">
            {{selectOptions ../advancedMagicSchoolChoices selected=entry.school localize=true}}
          </select>
          {{else if (eq entry.spellType "combined")}}
          <select name="system.apCostReductions.{{index}}.school">
            {{selectOptions ../combinedSchoolChoices selected=entry.school localize=true}}
          </select>
          {{else}}
          <select name="system.apCostReductions.{{index}}.school">
            {{selectOptions ../systemlessCategoryChoices selected=entry.school localize=true}}
          </select>
          {{/if}}
        </div>
        <div class="item-name">
          <input type="text" name="system.apCostReductions.{{index}}.flatFormula" value="{{entry.flatFormula}}"
            placeholder="e.g. L" />
        </div>
        <div class="item-controls">
          <a class="item-control item-delete" data-action="removeArrayEntry" data-field="apCostReductions"
            data-index="{{index}}" title="Remove">
            <i class="fas fa-trash"></i>
          </a>
        </div>
      </li>
      {{/each}}
    </ol>
  </div>

  <div class="resource">
    <label class="resource-label">Movement Bonuses</label>
    <ol class="items-list items-list-compact">
      <li class="item flexrow items-header">
        <div class="item-name">{{localize 'SKSK.General.Type'}}</div>
        <div class="item-name">Bonus</div>
        <div class="item-controls">
          <a class="item-control item-create" data-action="addMovementBonus" title="Add movement bonus">
            <i class="fas fa-plus"></i>
          </a>
        </div>
      </li>
      {{#each system.movementBonuses as |entry index|}}
      <li class="item flexrow">
        <div class="item-name">
          <select name="system.movementBonuses.{{index}}.movementType">
            {{selectOptions ../movementTypeChoices selected=entry.movementType localize=true}}
          </select>
        </div>
        <div class="item-name">
          <input type="text" name="system.movementBonuses.{{index}}.bonus" value="{{entry.bonus}}"
            data-dtype="Number" />
        </div>
        <div class="item-controls">
          <a class="item-control item-delete" data-action="removeArrayEntry" data-field="movementBonuses"
            data-index="{{index}}" title="Remove">
            <i class="fas fa-trash"></i>
          </a>
        </div>
      </li>
      {{/each}}
    </ol>
  </div>

  <div class="resource">
    <label class="resource-label">{{localize 'SKSK.FpGainBonus.Label'}}</label>
    <ol class="items-list items-list-compact">
      <li class="item flexrow items-header">
        <div class="item-name">{{localize 'SKSK.General.Skill'}}</div>
        <div class="item-name">Type</div>
        <div class="item-name">{{localize 'SKSK.General.Value'}}</div>
        <div class="item-name" title="{{localize 'SKSK.FpGainBonus.AllowZeroHint'}}">
          {{localize 'SKSK.FpGainBonus.AllowZero'}}
        </div>
        <div class="item-controls">
          <a class="item-control item-create" data-action="addFpGainBonus" title="Add FP gain bonus">
            <i class="fas fa-plus"></i>
          </a>
        </div>
      </li>
      {{#each system.fpGainBonuses as |entry index|}}
      <li class="item flexrow">
        <div class="item-name">
          <select name="system.fpGainBonuses.{{index}}.skill">
            {{selectOptions ../skillBonusChoices selected=entry.skill localize=true}}
          </select>
        </div>
        <div class="item-name">
          <select name="system.fpGainBonuses.{{index}}.bonusType">
            {{selectOptions ../fpGainBonusTypeChoices selected=entry.bonusType localize=true}}
          </select>
        </div>
        <div class="item-name">
          <input type="text" name="system.fpGainBonuses.{{index}}.amount" value="{{entry.amount}}"
            data-dtype="Number" />
        </div>
        <div class="item-name">
          <input type="checkbox" name="system.fpGainBonuses.{{index}}.allowZero" {{checked entry.allowZero}}
            title="{{localize 'SKSK.FpGainBonus.AllowZeroHint'}}" />
        </div>
        <div class="item-controls">
          <a class="item-control item-delete" data-action="removeArrayEntry" data-field="fpGainBonuses"
            data-index="{{index}}" title="Remove">
            <i class="fas fa-trash"></i>
          </a>
        </div>
      </li>
      {{/each}}
    </ol>
  </div>
</section>

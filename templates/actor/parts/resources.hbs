<aside class="side-tab side-tab-resources">
  <div class="side-tab-content flexcol">

    <div class="resource flex-group-center">
      <label class="resource-label" data-tooltip="{{localize 'SKSK.Resource.Life'}}" data-tooltip-html="{{lifeTooltip}}">
        {{localize 'SKSK.Resource.Life'}}
      </label>
      <div class="resource-content flexrow flex-center flex-between">
        <input type="text" class="resource-value-input" name="system.life.value" value="{{system.life.value}}"
          data-effect-key="system.life.bonus" />
      </div>
    </div>

    <div class="resource flex-group-center">
      <label class="resource-label" data-tooltip="{{localize 'SKSK.Resource.NegativeLife'}}" data-tooltip-html="{{negativeLifeTooltip}}">
        {{localize 'SKSK.Resource.NegativeLifeAbbr'}}
      </label>
      <div class="resource-content flexrow flex-center flex-between">
        <input type="text" class="resource-value-input" name="system.negativeLife.value" value="{{system.negativeLife.value}}" />
      </div>
    </div>

    <div class="resource flex-group-center">
      <label class="resource-label" data-tooltip="{{localize 'SKSK.Resource.Mana'}}" data-tooltip-html="{{manaTooltip}}">
        {{localize 'SKSK.Resource.Mana'}}
      </label>
      <div class="resource-content flexrow flex-center flex-between">
        <input type="text" class="resource-value-input" name="system.mana.value" value="{{system.mana.value}}"
          data-effect-key="system.mana.bonus" />
      </div>
    </div>

    <div class="resource flex-group-center">
      <label class="resource-label">{{localize 'SKSK.Resource.Barrier'}}</label>
      <div class="resource-content flexrow flex-center flex-between">
        <input type="text" name="system.barrier.value" value="{{system.barrier.value}}" data-dtype="Number" />
      </div>
    </div>

    <div class="resource flex-group-center">
      <label class="resource-label" data-tooltip="{{localize 'SKSK.Resource.AC'}}" data-tooltip-html="{{armorClassTooltip}}">
        {{localize 'SKSK.Resource.AC'}}
      </label>
      <div class="resource-content flexrow flex-center flex-between">
        <span class="resource-computed" data-effect-key="system.customArmorClassBonus">{{system.armorClass}}</span>
      </div>
    </div>

    <div class="resource flex-group-center">
      <label class="resource-label" data-tooltip="{{localize 'SKSK.Resource.MR'}}" data-tooltip-html="{{magicResistanceTooltip}}">
        {{localize 'SKSK.Resource.MR'}}
      </label>
      <div class="resource-content flexrow flex-center flex-between">
        <span class="resource-computed" data-effect-key="system.customMagicResistanceBonus">{{system.magicResistance}}</span>
      </div>
    </div>

    <div class="resource flex-group-center">
      <label class="resource-label">{{localize 'SKSK.Resource.AP'}}</label>
      <div class="resource-content flexrow flex-center flex-between">
        <input type="text" class="resource-value-input" name="system.actionPoints.value" value="{{system.actionPoints.value}}"
          data-effect-key="system.actionPoints.bonus" />
      </div>
    </div>

    <div class="resource flex-group-center">
      <label class="resource-label">{{localize 'SKSK.Resource.RP'}}</label>
      <div class="resource-content flexrow flex-center flex-between">
        <input type="text" class="resource-value-input" name="system.reactionPoints.value" value="{{system.reactionPoints.value}}"
          data-effect-key="system.reactionPoints.bonus" />
      </div>
    </div>

  </div>
</aside>

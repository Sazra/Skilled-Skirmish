<section class="tab" data-group="generalSections" data-tab="overview">

  <div class="resource">
    <label class="resource-label">{{localize 'SKSK.General.MovementSpeeds'}}</label>
    <div class="grid grid-6col">
      {{#each movementSpeeds as |m|}}
      <div class="grid-span-1 movement-speed-entry">
        <label class="resource-label">{{localize m.label}}</label>
        <div class="movement-speed-value">{{m.value}}m</div>
      </div>
      {{/each}}
    </div>
  </div>

  <div class="grid grid-2col general-columns">

    <div class="grid-span-1 resource">
      <label class="resource-label">{{localize 'SKSK.General.FavoriteSkills'}}</label>
      <ol class="items-list items-list-compact">
        {{#each favoriteSkills as |skill|}}
        <li class="item flexrow">
          <div class="item-name"><h4>{{localize skill.label}}</h4></div>
          <div class="skill-level">{{skill.level}} / {{skill.maxLevel}}</div>
        </li>
        {{else}}
        <li class="item flexrow">
          <div class="item-name">{{localize 'SKSK.General.NoFavoriteSkills'}}</div>
        </li>
        {{/each}}
      </ol>
    </div>

    <div class="grid-span-1 resource">
      <label class="resource-label">{{localize 'SKSK.General.AdditionalResources'}}</label>
      <ol class="items-list items-list-compact">
        <li class="item flexrow items-header">
          <div class="item-name">{{localize 'Name'}}</div>
          <div class="item-name" title="{{localize 'SKSK.General.AbbreviationHint'}}">{{localize 'SKSK.General.Abbreviation'}}</div>
          <div class="item-name">{{localize 'SKSK.SheetLabels.Resources'}}</div>
          <div class="item-controls">
            <a class="item-control item-create" data-action="addResource" title="{{localize 'SKSK.General.AddResource'}}">
              <i class="fas fa-plus"></i>
            </a>
          </div>
        </li>
        {{#each generalResources as |res|}}
        <li class="item flexrow">
          <div class="item-name">{{localize res.label}}</div>
          <div class="item-name"></div>
          <div class="item-name flexrow flex-center">
            <input type="text" name="system.{{res.key}}.value" value="{{res.value}}" data-dtype="Number" />
            <span>/</span>
            <span class="resource-computed">{{res.max}}</span>
          </div>
          <div class="item-controls"></div>
        </li>
        {{/each}}
        {{#each system.customResources as |entry index|}}
        <li class="item flexrow">
          <div class="item-name">
            <input type="text" name="system.customResources.{{index}}.name" value="{{entry.name}}"
              placeholder="{{localize 'Name'}}" />
          </div>
          <div class="item-name">
            <input type="text" name="system.customResources.{{index}}.abbreviation" value="{{entry.abbreviation}}"
              maxlength="4" class="resource-abbreviation" placeholder="e.g. RAGE"
              title="{{localize 'SKSK.General.AbbreviationHint'}}" />
          </div>
          <div class="item-name flexrow flex-center">
            <input type="text" name="system.customResources.{{index}}.value" value="{{entry.value}}"
              data-dtype="Number" />
            <span>/</span>
            <input type="text" name="system.customResources.{{index}}.max" value="{{entry.max}}"
              data-dtype="Number" />
          </div>
          <div class="item-controls">
            <a class="item-control item-delete" data-action="removeResource" data-index="{{index}}"
              title="{{localize 'DOCUMENT.Delete' type='Resource'}}">
              <i class="fas fa-trash"></i>
            </a>
          </div>
        </li>
        {{/each}}
      </ol>
    </div>

  </div>

</section>

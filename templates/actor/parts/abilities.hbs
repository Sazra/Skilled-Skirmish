<section class="tab {{tab.cssClass}}" data-group="primary" data-tab="abilities">
  <ol class="items-list">
    <li class="item flexrow items-header">
      <div class="item-source">Source</div>
      <div class="item-name">{{localize 'Name'}}</div>
      <div class="item-description">{{localize 'SKSK.Items.Description'}}</div>
      <div class="item-controls">
        <a class="item-control item-create" data-action="createItem" title="{{localize 'DOCUMENT.New' type='talent'}}"
          data-type="talent">
          <i class="fas fa-plus"></i>
        </a>
      </div>
    </li>

    {{#each classAndSpeciesAbilities as |ability|}}
    <li class="item flexrow" data-item-id="{{ability.sourceId}}">
      <div class="item-source">{{ability.sourceLabel}}</div>
      <div class="item-name">
        <div class="item-image">
          <img src="{{ability.sourceImg}}" title="{{ability.sourceLabel}}" width="24" height="24" />
        </div>
        <h4>{{ability.name}}</h4>
      </div>
      <div class="item-description" title="{{ability.description}}">{{ability.description}}</div>
      <div class="item-controls">
        <a class="item-control item-edit" data-action="editItem" title="Open {{ability.sourceLabel}}">
          <i class="fas fa-edit"></i>
        </a>
      </div>
    </li>
    {{/each}}

    {{#each talents as |talent|}}
    <li class="item flexrow" data-item-id="{{talent._id}}">
      <div class="item-source">{{talent.typeLabel}}</div>
      <div class="item-name">
        <div class="item-image">
          <a class="rollable" data-action="roll" data-roll-type="item">
            <img src="{{talent.img}}" title="{{talent.name}}" width="24" height="24" />
          </a>
        </div>
        <h4>{{talent.name}}</h4>
      </div>
      <div class="item-description" title="{{talent.system.ability}}">{{talent.system.ability}}</div>
      <div class="item-controls">
        <a class="item-control item-edit" data-action="editItem" title="{{localize 'DOCUMENT.Update' type='Talent'}}">
          <i class="fas fa-edit"></i>
        </a>
        <a class="item-control item-delete" data-action="deleteItem" title="{{localize 'DOCUMENT.Delete' type='Talent'}}">
          <i class="fas fa-trash"></i>
        </a>
      </div>
    </li>
    {{/each}}
  </ol>
</section>

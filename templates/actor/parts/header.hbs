{{!-- Sheet Header --}}
<header class="sheet-header">
  <img class="profile-img" src="{{actor.img}}" data-edit="img" title="{{actor.name}}" height="100" width="100" />
  <div class="header-fields">
    <h1 class="charname"><input name="name" type="text" value="{{actor.name}}" placeholder="Name" /></h1>

    <div class="header-items flexrow">
      <div class="header-item-list">
        <label class="resource-label">Class</label>
        <ol class="items-list compact-list">
          {{#each classes as |cls|}}
          <li class="item flexrow" data-item-id="{{cls._id}}">
            <a class="item-name flexrow" data-action="editItem">
              <img class="item-image" src="{{cls.img}}" width="16" height="16" />
              <span>{{cls.name}}</span>
              <span class="item-type-label">({{cls.typeLabel}})</span>
            </a>
            <a class="item-control item-delete" data-action="deleteItem" title="Remove">
              <i class="fas fa-times"></i>
            </a>
          </li>
          {{/each}}
        </ol>
      </div>
      <div class="header-item-list">
        <label class="resource-label">Species</label>
        <ol class="items-list compact-list">
          {{#each species as |sp|}}
          <li class="item flexrow" data-item-id="{{sp._id}}">
            <a class="item-name flexrow" data-action="editItem">
              <img class="item-image" src="{{sp.img}}" width="16" height="16" />
              <span>{{sp.name}}</span>
              <span class="item-type-label">({{sp.typeLabel}})</span>
            </a>
            <a class="item-control item-delete" data-action="deleteItem" title="Remove">
              <i class="fas fa-times"></i>
            </a>
          </li>
          {{/each}}
        </ol>
      </div>
    </div>
  </div>
  <div class="header-level flex-group-center">
    <label for="system.resources.level.value" class="resource-label">Level</label>
    <input type="text" name="system.resources.level.value" value="{{system.resources.level.value}}"
      data-dtype="Number" />
  </div>
  <div class="header-size flex-group-center">
    <label for="system.sizeCategory" class="resource-label">{{localize 'SKSK.General.SizeCategory'}}</label>
    <select name="system.sizeCategory">
      {{selectOptions sizeCategoryChoices selected=sizeCategory localize=true}}
    </select>
  </div>
  <div class="header-rest flex-group-center">
    <a class="item-control" data-action="openRestDialog" title="{{localize 'SKSK.Rest.Title'}}">
      <i class="fas fa-clock"></i>
    </a>
    <a class="item-control" data-action="openTrainingDialog" title="{{localize 'SKSK.Training.Title'}}">
      <i class="fas fa-dumbbell"></i>
    </a>
    <a class="item-control" data-action="openPrayerDialog" title="{{localize 'SKSK.Prayer.Title'}}">
      <i class="fas fa-hands-praying"></i>
    </a>
    <a class="item-control" data-action="openSummoningDialog" title="{{localize 'SKSK.Summoning.Title'}}">
      <i class="fas fa-dragon"></i>
    </a>
  </div>
  <div class="header-passive-perception flex-group-center">
    <label class="resource-label">{{localize 'SKSK.General.PassivePerception'}}</label>
    <a class="item-control" data-action="grantPassivePerceptionFp" title="{{localize 'SKSK.General.PassivePerception'}}">
      {{passivePerception}}
    </a>
  </div>
</header>
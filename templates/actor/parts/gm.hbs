<section class="tab {{tab.cssClass}}" data-group="primary" data-tab="gm">

  <div class="resource">
    <label class="resource-label">{{localize 'SKSK.GM.Switches'}}</label>
    <label class="casting-method-option" title="{{localize 'SKSK.NegativeLife.IncludeToughnessHint'}}">
      <input type="checkbox" name="system.negativeLife.includeToughness" {{checked system.negativeLife.includeToughness}} />
      {{localize 'SKSK.NegativeLife.IncludeToughness'}}
    </label>
  </div>

  <div class="grid grid-2col">
    <div class="grid-span-1">
      <label class="resource-label" title="{{localize 'SKSK.GM.NaturalMaterialBonusHint'}}">
        {{localize 'SKSK.GM.NaturalMaterialBonus'}}
      </label>
      <input type="text" name="system.naturalMaterialBonus.adjustment" value="{{system.naturalMaterialBonus.adjustment}}"
        data-dtype="Number" />
    </div>
    <div class="grid-span-1">
      <label class="resource-label">{{localize 'SKSK.GM.NaturalMaterialBonusValue'}}</label>
      <span class="resource-computed">{{system.naturalMaterialBonus.value}}</span>
    </div>
  </div>

  <div class="grid grid-3col">
    <div class="grid-span-1">
      <label class="resource-label" title="{{localize 'SKSK.GM.BaseArmorClassHint'}}">
        {{localize 'SKSK.GM.BaseArmorClass'}}
      </label>
      <input type="text" name="system.baseArmorClass" value="{{system.baseArmorClass}}" data-dtype="Number" />
    </div>
    <div class="grid-span-1">
      <label class="resource-label" title="{{localize 'SKSK.GM.CustomArmorClassBonusHint'}}">
        {{localize 'SKSK.GM.CustomArmorClassBonus'}}
      </label>
      <input type="text" name="system.customArmorClassBonus" value="{{system.customArmorClassBonus}}" data-dtype="Number" />
    </div>
    <div class="grid-span-1">
      <label class="resource-label" title="{{localize 'SKSK.GM.CustomMagicResistanceBonusHint'}}">
        {{localize 'SKSK.GM.CustomMagicResistanceBonus'}}
      </label>
      <input type="text" name="system.customMagicResistanceBonus" value="{{system.customMagicResistanceBonus}}" data-dtype="Number" />
    </div>
  </div>

  <div class="resource">
    <label class="resource-label">{{localize 'SKSK.MartialArtsAttack.SectionTitle'}}</label>
    <ol class="items-list">
      <li class="item flexrow items-header">
        <div class="item-name">{{localize 'SKSK.MartialArtsAttack.Name'}}</div>
        <div class="item-controls">
          <a class="item-control" data-action="addMartialArtsAttack" title="{{localize 'SKSK.MartialArtsAttack.Add'}}">
            <i class="fas fa-plus"></i>
          </a>
        </div>
      </li>
      {{#each system.martialArtsAttacks as |attack index|}}
      <li class="item flexcol model-entry">
        <div class="flexrow flex-between">
          <input type="text" name="system.martialArtsAttacks.{{index}}.name" value="{{attack.name}}"
            placeholder="{{localize 'SKSK.MartialArtsAttack.Name'}}" />
          <a class="item-control item-delete" data-action="removeMartialArtsAttack" data-index="{{index}}"
            title="{{localize 'SKSK.MartialArtsAttack.Remove'}}">
            <i class="fas fa-trash"></i>
          </a>
        </div>

        <div class="grid grid-3col">
          <div class="grid-span-1">
            <label class="resource-label">{{localize 'SKSK.MartialArtsAttack.Formula'}}</label>
            <input type="text" name="system.martialArtsAttacks.{{index}}.formula" value="{{attack.formula}}"
              placeholder="e.g. 1d6" />
          </div>
          <div class="grid-span-1">
            <label class="resource-label">{{localize 'SKSK.MartialArtsAttack.APCost'}}</label>
            <input type="text" name="system.martialArtsAttacks.{{index}}.apCost" value="{{attack.apCost}}"
              data-dtype="Number" />
          </div>
          <div class="grid-span-1">
            <label class="resource-label">{{localize 'SKSK.MartialArtsAttack.AttributeUsage'}}</label>
            <select name="system.martialArtsAttacks.{{index}}.attributeUsage">
              {{selectOptions ../attributeUsageChoices selected=attack.attributeUsage localize=true}}
            </select>
          </div>
        </div>

        <label class="resource-label">{{localize 'SKSK.MartialArtsAttack.Attributes'}}</label>
        <div class="grid grid-4col model-checkbox-grid">
          {{#each ../attributeChoices as |label key|}}
          <label class="casting-method-option">
            <input type="checkbox" name="system.martialArtsAttacks.{{index}}.attributes.{{key}}"
              {{checked (lookup attack.attributes key)}} />
            {{localize label}}
          </label>
          {{/each}}
        </div>
      </li>
      {{else}}
      <li class="item flexrow">
        <div class="item-name">{{localize 'SKSK.MartialArtsAttack.None'}}</div>
      </li>
      {{/each}}
    </ol>
  </div>

</section>

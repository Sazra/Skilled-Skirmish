<ol class='items-list items-list-compact'>
  <li class='item flexrow items-header'>
    <div class='item-name'>{{localize 'Name'}}</div>
    <div class='item-combat-bonus' title="{{localize 'SKSK.Items.CombatBonus'}}">{{localize 'SKSK.Items.CombatBonusAbbr'}}</div>
    <div class='item-damage-formula' title="{{localize 'SKSK.Items.Damage'}}">{{localize 'SKSK.Items.DamageAbbr'}}</div>
    {{#if durabilityEnabled}}
    <div class='item-durability' title="{{localize 'SKSK.Durability.Name'}}">{{localize 'SKSK.Durability.Abbr'}}</div>
    {{/if}}
    <div class='item-weight' title="{{localize 'SKSK.Items.Weight'}}">{{localize 'SKSK.Items.WeightAbbr'}}</div>
    <div class='item-equipped' title="{{localize 'SKSK.Items.Equipped'}}">{{localize 'SKSK.Items.EquippedAbbr'}}</div>
    <div class='item-enchanted' title="{{localize 'SKSK.Items.Enchanted'}}">{{localize 'SKSK.Items.EnchantedAbbr'}}</div>
    <div class='item-quantity' title="{{localize 'SKSK.Items.Quantity'}}">{{localize 'SKSK.Items.QuantityAbbr'}}</div>
    <div class='item-consumable' title="{{localize 'SKSK.Items.Consumable'}}">{{localize 'SKSK.Items.ConsumableAbbr'}}</div>
    <div class='item-controls'>
      <div class='item-create-dropdown'>
        <a
          class='item-control item-create-toggle'
          data-action='toggleCreateItemMenu'
          title='{{localize "SKSK.Items.CreateNew"}}'
        >
          <i class='fas fa-plus'></i>
        </a>
        <ul class='item-create-menu' hidden>
          <li><a data-action='createItem' data-type='item'>{{localize "SKSK.Items.CreateItem"}}</a></li>
          <li><a data-action='createItem' data-type='weapon'>{{localize "SKSK.Items.CreateWeapon"}}</a></li>
          <li><a data-action='createItem' data-type='armor'>{{localize "SKSK.Items.CreateArmor"}}</a></li>
        </ul>
      </div>
    </div>
  </li>
  {{#each gear as |item id|}}
    <li class='item flexrow' data-item-id='{{item._id}}'>
      <div class='item-name'>
        <div class='item-image'>
          <a data-action='editItem' title='{{localize "DOCUMENT.Update" type="Item"}}'>
            <img
              src='{{item.img}}'
              title='{{item.name}}'
              width='24'
              height='24'
            />
          </a>
        </div>
        <i class="fas {{item.typeIcon}} item-type-icon" title="{{item.typeLabel}}"></i>
        <h4 class="item-name-heading" data-action="editItem" title='{{localize "DOCUMENT.Update" type="Item"}}'>{{item.name}}</h4>
      </div>
      <div class='item-combat-bonus'>
        {{#if (eq item.type "armor")}}
        {{numberFormat item.acBonus decimals=0 sign=true}}
        {{else if (eq item.type "weapon")}}
        {{numberFormat item.attackBonus decimals=0 sign=true}}
        {{/if}}
      </div>
      <div class='item-damage-formula'>
        {{#if (eq item.type "weapon")}}{{item.system.formula}}{{/if}}
      </div>
      {{#if ../durabilityEnabled}}
      <div class='item-durability'>
        <div class="durability-box-wrapper">
          <span class="durability-value-display" data-action="editDurability">{{item.system.durability.value}} / {{item.system.maxDurability}}</span>
          <input type="text" class="durability-value-input" value="{{item.system.durability.value}}" data-dtype="Number" />
        </div>
      </div>
      {{/if}}
      <div class='item-weight'>{{item.system.weight}}</div>
      <div class='item-equipped'>
        {{#if (eq item.type "item")}}
          {{#if item.system.equippable}}
          <i class="fas {{#if item.system.equipped}}fa-check{{else}}fa-times{{/if}}"></i>
          {{/if}}
        {{else}}
        <i class="fas {{#if item.system.equipped}}fa-check{{else}}fa-times{{/if}}"></i>
        {{/if}}
      </div>
      <div class='item-enchanted'>
        {{#if (eq item.type "item")}}
          {{#if item.system.equippable}}
          <i class="fas {{#if item.system.enchanted}}fa-check{{else}}fa-times{{/if}}"></i>
          {{/if}}
        {{else}}
        <i class="fas {{#if item.system.enchanted}}fa-check{{else}}fa-times{{/if}}"></i>
        {{/if}}
      </div>
      <div class='item-quantity'>
        {{#if (eq item.type "item")}}{{item.system.quantity}}{{/if}}
      </div>
      <div class='item-consumable'>
        {{#if (eq item.type "item")}}
        <i class="fas {{#if item.system.consumable}}fa-check{{else}}fa-times{{/if}}"></i>
        {{/if}}
      </div>
      <div class='item-controls'>
        <a
          class='item-control item-delete'
          data-action='deleteItem'
          title='{{localize "DOCUMENT.Delete" type='Item'}}'
        >
          <i class='fas fa-trash'></i>
        </a>
      </div>
    </li>
  {{/each}}
</ol>

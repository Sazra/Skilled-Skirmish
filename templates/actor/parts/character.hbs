<section class="tab" data-group="generalSections" data-tab="character">

  <nav class="sheet-tabs tabs character-section-tabs" data-group="characterSections">
    {{#each characterSectionTabs as |sec|}}
    <a class="{{sec.cssClass}}" data-action="tab" data-group="characterSections" data-tab="{{sec.id}}">
      <label>{{localize sec.label}}</label>
    </a>
    {{/each}}
  </nav>

  <section class="tab" data-group="characterSections" data-tab="data">

    <div class="grid grid-4col">
      <div class="resource">
        <label class="resource-label">{{localize 'SKSK.Data.Gender'}}</label>
        <select name="system.gender">
          {{selectOptions genderChoices selected=system.gender localize=true}}
        </select>
      </div>
      <div class="resource">
        <label class="resource-label">{{localize 'SKSK.Data.Age'}}</label>
        <input type="text" name="system.age" value="{{system.age}}" />
      </div>
      <div class="resource">
        <label class="resource-label">{{localize 'SKSK.Data.Height'}}</label>
        <input type="text" name="system.height" value="{{system.height}}" />
      </div>
      <div class="resource">
        <label class="resource-label">{{localize 'SKSK.General.SizeCategory'}}</label>
        <select name="system.sizeCategory">
          {{selectOptions sizeCategoryChoices selected=sizeCategory localize=true}}
        </select>
      </div>
    </div>

    <div class="grid grid-3col">
      <div class="resource">
        <label class="resource-label">{{localize 'SKSK.Data.SkinColor'}}</label>
        <input type="text" name="system.skinColor" value="{{system.skinColor}}" />
      </div>
      <div class="resource">
        <label class="resource-label">{{localize 'SKSK.Data.HairColor'}}</label>
        <input type="text" name="system.hairColor" value="{{system.hairColor}}" />
      </div>
      <div class="resource">
        <label class="resource-label">{{localize 'SKSK.Data.EyeColor'}}</label>
        <input type="text" name="system.eyeColor" value="{{system.eyeColor}}" />
      </div>
    </div>

    <div class="resource">
      <label class="resource-label">{{localize 'SKSK.Data.AdditionalData'}}</label>
      <ol class="items-list items-list-compact">
        <li class="item flexrow items-header">
          <div class="item-name">{{localize 'SKSK.Data.Label'}}</div>
          <div class="item-name">{{localize 'SKSK.Data.Value'}}</div>
          <div class="item-controls">
            <a class="item-control item-create" data-action="addAdditionalData" title="{{localize 'SKSK.Data.AddEntry'}}">
              <i class="fas fa-plus"></i>
            </a>
          </div>
        </li>
        {{#each system.additionalData as |entry index|}}
        <li class="item flexrow">
          <div class="item-name">
            <input type="text" name="system.additionalData.{{index}}.label" value="{{entry.label}}"
              placeholder="{{localize 'SKSK.Data.Label'}}" />
          </div>
          <div class="item-name">
            <input type="text" name="system.additionalData.{{index}}.value" value="{{entry.value}}"
              placeholder="{{localize 'SKSK.Data.Value'}}" />
          </div>
          <div class="item-controls">
            <a class="item-control item-delete" data-action="removeAdditionalData" data-index="{{index}}"
              title="Remove">
              <i class="fas fa-trash"></i>
            </a>
          </div>
        </li>
        {{/each}}
      </ol>
    </div>

  </section>

  <section class="tab" data-group="characterSections" data-tab="biography">
    <prose-mirror name="system.biography" toggled value="{{actor.system.biography}}" data-document-uuid="{{actor.uuid}}" {{#unless editable}}disabled{{/unless}}>
      {{{biographyHTML}}}
    </prose-mirror>
  </section>

  {{#unless isNpc}}
  <section class="tab" data-group="characterSections" data-tab="longevity">

    <div class="resource">
      <label class="resource-label">{{localize 'SKSK.Longevity.Current'}}</label>
      <p>
        {{localize 'SKSK.Longevity.Breakdown'
          years=longevityBreakdown.years months=longevityBreakdown.months
          weeks=longevityBreakdown.weeks days=longevityBreakdown.days}}
      </p>
      <p>
        {{localize 'SKSK.Longevity.TotalDays' days=system.longevity.days}}
        ({{numberFormat system.longevity.percent decimals=1}}%)
      </p>
    </div>

    <div class="grid grid-2col">
      <div class="resource longevity-unit-row">
        <label class="resource-label">{{localize 'SKSK.Longevity.Year'}}</label>
        <div class="item-controls flexrow flex-center">
          <a class="item-control" data-action="adjustLongevity" data-unit="year" data-direction="decrease" title="-">
            <i class="fas fa-minus"></i>
          </a>
          <input type="number" class="longevity-amount-input" min="1" value="1" />
          <a class="item-control" data-action="adjustLongevity" data-unit="year" data-direction="increase" title="+">
            <i class="fas fa-plus"></i>
          </a>
        </div>
      </div>
      <div class="resource longevity-unit-row">
        <label class="resource-label">{{localize 'SKSK.Longevity.Month'}}</label>
        <div class="item-controls flexrow flex-center">
          <a class="item-control" data-action="adjustLongevity" data-unit="month" data-direction="decrease" title="-">
            <i class="fas fa-minus"></i>
          </a>
          <input type="number" class="longevity-amount-input" min="1" value="1" />
          <a class="item-control" data-action="adjustLongevity" data-unit="month" data-direction="increase" title="+">
            <i class="fas fa-plus"></i>
          </a>
        </div>
      </div>
      <div class="resource longevity-unit-row">
        <label class="resource-label">{{localize 'SKSK.Longevity.Week'}}</label>
        <div class="item-controls flexrow flex-center">
          <a class="item-control" data-action="adjustLongevity" data-unit="week" data-direction="decrease" title="-">
            <i class="fas fa-minus"></i>
          </a>
          <input type="number" class="longevity-amount-input" min="1" value="1" />
          <a class="item-control" data-action="adjustLongevity" data-unit="week" data-direction="increase" title="+">
            <i class="fas fa-plus"></i>
          </a>
        </div>
      </div>
      <div class="resource longevity-unit-row">
        <label class="resource-label">{{localize 'SKSK.Longevity.Day'}}</label>
        <div class="item-controls flexrow flex-center">
          <a class="item-control" data-action="adjustLongevity" data-unit="day" data-direction="decrease" title="-">
            <i class="fas fa-minus"></i>
          </a>
          <input type="number" class="longevity-amount-input" min="1" value="1" />
          <a class="item-control" data-action="adjustLongevity" data-unit="day" data-direction="increase" title="+">
            <i class="fas fa-plus"></i>
          </a>
        </div>
      </div>
    </div>

  </section>
  {{/unless}}

</section>

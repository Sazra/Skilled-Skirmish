            <li class="item flexrow items-header">
              <div class="spell-level">Lvl</div>
              <div class="item-name">{{localize "Name"}}</div>
              <div class="item-controls">
                <a class="item-control item-create" data-action="createItem" data-type="spell"
                  data-spell-type="advanced" data-magic-school="{{s.id}}" title="{{localize 'DOCUMENT.New' type='spell'}}">
                  <i class="fas fa-plus"></i>
                </a>
              </div>
            </li>
            {{#each (lookup ../spellsByAdvancedSchool s.id) as |item|}}
            <li class="item flexrow" data-item-id="{{item._id}}">
              <div class="spell-level">{{item.system.spellLevel}}</div>
              <div class="item-name flexrow">
                <div class="item-image">
                  <a class="rollable" data-action="roll" data-roll-type="item">
                    <img src="{{item.img}}" title="{{item.name}}" width="24" height="24" />
                  </a>
                </div>
                <h4>{{item.name}}</h4>
              </div>
              <div class="item-controls">
                <a class="item-control item-edit" data-action="editItem" title="{{localize 'DOCUMENT.Update' type='Item'}}">
                  <i class="fas fa-edit"></i>
                </a>
                <a class="item-control item-delete" data-action="deleteItem" title="{{localize 'DOCUMENT.Delete' type='Item'}}">
                  <i class="fas fa-trash"></i>
                </a>
              </div>
            </li>
            {{/each}}
          </ol>
        </section>
        {{/each}}
      </section>

      <section class="tab" data-group="spellTypes" data-tab="combined">

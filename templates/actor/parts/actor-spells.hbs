<section class="tab {{tab.cssClass}}" data-group="primary" data-tab="spells">

  <div class="spells-layout">

    <nav class="sheet-tabs tabs spell-type-tabs" data-group="spellTypes">
      {{#each spellTypeTabs as |t|}}
      <a class="{{t.cssClass}}" data-action="tab" data-group="spellTypes" data-tab="{{t.id}}">
        <label>{{localize t.label}}</label>
      </a>
      {{/each}}
    </nav>

    <div class="spell-type-body">

      <section class="tab" data-group="spellTypes" data-tab="simple">
        <nav class="sheet-tabs tabs spell-school-tabs" data-group="spellSimpleSchools">
          {{#each spellSimpleSchoolTabs as |s|}}
          <a class="{{s.cssClass}}" data-action="tab" data-group="spellSimpleSchools" data-tab="{{s.id}}">
            <label>{{localize s.label}}</label>
          </a>
          {{/each}}
        </nav>
        {{#each spellSimpleSchoolTabs as |s|}}
        <section class="tab" data-group="spellSimpleSchools" data-tab="{{s.id}}">
          <ol class="items-list">
            <li class="item flexrow items-header">
              <div class="spell-level">Lvl</div>
              <div class="item-name">{{localize "Name"}}</div>
              <div class="spell-cost">{{localize 'SKSK.Spell.ManaCost'}}/{{localize 'SKSK.Spell.APCost'}}</div>
              <div class="spell-range">{{localize 'SKSK.Spell.Ranges'}}</div>
              <div class="spell-methods"></div>
              <div class="item-controls">
                <a class="item-control item-create" data-action="createItem" data-type="spell" data-spell-type="simple"
                  data-magic-school="{{s.id}}" title="{{localize 'DOCUMENT.New' type='spell'}}">
                  <i class="fas fa-plus"></i>
                </a>
              </div>
            </li>
            {{#each (lookup ../spellsBySimpleSchool s.id) as |item|}}
            <li class="item flexrow {{#unless item.castable}}spell-uncastable{{/unless}}" data-item-id="{{item._id}}">
              <div class="spell-level">{{item.system.spellLevel}}</div>
              <div class="item-name flexrow">
                <div class="item-image">
                  <a class="rollable" data-action="roll" data-roll-type="item">
                    <img src="{{item.img}}" title="{{item.name}}" width="24" height="24" />
                  </a>
                </div>
                <h4>{{item.name}}</h4>
                {{#unless item.castable}}
                <i class="fas fa-exclamation-triangle spell-prerequisite-warning"
                  title="{{localize 'SKSK.Spell.PrerequisiteNotMet' details=item.missingLabel}}"></i>
                {{/unless}}
              </div>
              <div class="spell-cost" title="{{localize 'SKSK.Spell.ManaCost'}} / {{localize 'SKSK.Spell.APCost'}}">
                <span class="spell-cost-line {{#if item.manaCostIncreased}}mana-cost-increased{{/if}}"><i class="fas fa-tint"></i>{{item.effectiveManaCost}}</span>
                <span class="spell-cost-line"><i class="fas fa-bolt {{#if item.apCostIconGood}}ap-cost-icon-good{{/if}}"></i><span class="{{#if item.castable}}ap-cost-text-good{{/if}}">{{item.effectiveApCost}}</span></span>
              </div>
              <div class="spell-range" title="{{localize 'SKSK.Spell.Ranges'}}">
                {{#each item.system.ranges as |range|}}{{#unless @first}}/{{/unless}}{{range.distance}}m{{/each}}
              </div>
              <div class="spell-methods">
                {{#if item.system.castingMethods.vocal}}
                <span class="spell-method-letter" title="{{localize 'SKSK.Spell.CastingMethod.Vocal'}}">{{firstLetter (localize "SKSK.Spell.CastingMethod.Vocal")}}</span>
                {{/if}}
                {{#if item.system.castingMethods.runes}}
                <span class="spell-method-letter" title="{{localize 'SKSK.Spell.CastingMethod.Runes'}}">{{firstLetter (localize "SKSK.Spell.CastingMethod.Runes")}}</span>
                {{/if}}
                {{#if item.system.castingMethods.movement}}
                <span class="spell-method-letter" title="{{localize 'SKSK.Spell.CastingMethod.Movement'}}">{{firstLetter (localize "SKSK.Spell.CastingMethod.Movement")}}</span>
                {{/if}}
                {{#if item.system.castingMethods.concentration}}
                <span class="spell-method-letter" title="{{localize 'SKSK.Spell.CastingMethod.Concentration'}}">{{firstLetter (localize "SKSK.Spell.CastingMethod.Concentration")}}</span>
                {{/if}}
                {{#if item.system.castingMethods.sacrifice}}
                <i class="fas fa-circle spell-method-icon" title="{{localize 'SKSK.Spell.CastingMethod.Sacrifice'}}"></i>
                {{/if}}
                {{#if item.system.castingMethods.medium}}
                <i class="fas fa-square spell-method-icon" title="{{localize 'SKSK.Spell.CastingMethod.Medium'}}"></i>
                {{/if}}
                {{#if item.system.castingMethods.ritual}}
                <i class="fas fa-star spell-method-icon" title="{{localize 'SKSK.Spell.CastingMethod.Ritual'}}"></i>
                {{/if}}
              </div>
              <div class="item-controls">
                <a class="item-control item-edit" data-action="editItem" title="{{localize 'DOCUMENT.Update' type='Item'}}">
                  <i class="fas fa-edit"></i>
                </a>
                <a class="item-control item-delete" data-action="deleteItem" title="{{localize 'DOCUMENT.Delete' type='Item'}}">
                  <i class="fas fa-trash"></i>
                </a>
              </div>
            </li>
            {{/each}}
          </ol>
        </section>
        {{/each}}
      </section>


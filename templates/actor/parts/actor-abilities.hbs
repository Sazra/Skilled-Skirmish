<section class="tab tab-talents active">
    <ol class='items-list'>
        <li class='item flexrow items-header'>
            <div class='item-name'>{{localize 'Name'}}</div>
            <div class='item-controls'>
                <a class='item-control item-create' data-action='createItem' title='Create item' data-type='talent'>
                    <i class='fas fa-plus'></i>
                    {{localize 'DOCUMENT.New' type='talent'}}
                </a>
            </div>
        </li>
        {{#each talents as |talent id|}}
        <li class='item flexrow' data-item-id='{{talent._id}}'>
            <div class='item-name'>
                <div class='item-image'>
                    <a class='rollable' data-action='roll' data-roll-type='item'>
                        <img src='{{talent.img}}' title='{{talent.name}}' width='24' height='24' />
                    </a>
                </div>
                <h4>{{talent.name}}</h4>
            </div>
            <div class='item-controls'>
                <a class='item-control item-edit' data-action='editItem' title='{{localize "DOCUMENT.Edit" type='
                    talent'}}'>
                    <i class='fas fa-edit'></i>
                </a>
                <a class='item-control item-delete' data-action='deleteItem' title='{{localize "DOCUMENT.Delete" type='
                    talent'}}'>
                    <i class='fas fa-trash'></i>
                </a>
            </div>
        </li>
        {{/each}}
    </ol>
</section>

<section class="tab tab-classes">
    <ol class='items-list'>
        {{#each classes as |class id|}}
        <li class='item flexrow' data-item-id='{{class._id}}'>
            <div class='item-name'>
                <div class='item-image'>
                    <a class='rollable' data-action='roll' data-roll-type='item'>
                        <img src='{{class.img}}' title='{{class.name}}' width='24' height='24' />
                    </a>
                </div>
                <h4>{{class.name}}</h4>
            </div>
            <div class='item-controls'>
                <a class='item-control item-edit' data-action='editItem' title='{{localize "DOCUMENT.Edit" type='
                    class'}}'>
                    <i class='fas fa-edit'></i>
                </a>
                <a class='item-control item-delete' data-action='deleteItem' title='{{localize "DOCUMENT.Delete" type='
                    class'}}'>
                    <i class='fas fa-trash'></i>
                </a>
            </div>
        </li>
        {{/each}}
    </ol>
</section>
<div class="sksk-mass-kill-dialog">
  <div class="resource">
    <label class="resource-label">{{localize 'SKSK.KillDialog.Title'}}</label>
    <div class="flexrow flex-center">
      <select data-kill-field="skillKey">
        {{#each skillChoices as |def key|}}
        <option value="{{key}}" {{#if (eq key ../skillKey)}}selected{{/if}}>{{localize def.label}}</option>
        {{/each}}
      </select>
      <button type="button" data-action="confirmKill">{{localize 'SKSK.KillDialog.Confirm'}}</button>
    </div>
  </div>

  <div class="resource">
    <label class="resource-label" title="{{localize 'SKSK.MassKill.SectionHint'}}">{{localize 'SKSK.MassKill.SectionTitle'}}</label>
    <div class="flexrow flex-center mass-kill-buttons">
      {{#each massKillTiers as |tier|}}
      <button type="button" data-action="grantMassKillFp" data-tier="{{tier}}" title="{{localize 'SKSK.MassKill.SectionHint'}}">{{tier}}</button>
      {{/each}}
    </div>
  </div>
</div>

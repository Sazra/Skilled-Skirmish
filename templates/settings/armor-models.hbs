<section class="tab {{tab.cssClass}}" data-group="primary" data-tab="armorModels">

  <nav class="sheet-tabs tabs armor-model-type-tabs" data-group="armorModelTypes">
    {{#each armorModelTypeTabs as |t|}}
    <a class="{{t.cssClass}}" data-action="tab" data-group="armorModelTypes" data-tab="{{t.id}}">
      <label>{{localize t.label}}</label>
    </a>
    {{/each}}
  </nav>

  {{#each armorModelTypeTabs as |t|}}
  <section class="tab" data-group="armorModelTypes" data-tab="{{t.id}}">
    <ol class="items-list">
      <li class="item flexrow items-header">
        <div class="item-name">{{localize t.label}}</div>
        <div class="item-controls">
          <a class="item-control" data-action="addArmorModel" data-armor-type="{{t.id}}"
            title="{{localize 'SKSK.Models.Add'}}">
            <i class="fas fa-plus"></i>
          </a>
        </div>
      </li>
      {{#each (lookup ../armorModelsByType t.id) as |entry|}}
      <li class="item flexcol model-entry">
        <div class="flexrow flex-between">
          <input type="text" name="armorModels.{{entry.index}}.name" value="{{entry.model.name}}"
            placeholder="{{localize 'SKSK.Models.Name'}}" />
          <a class="item-control item-delete" data-action="removeArmorModel" data-index="{{entry.index}}"
            title="{{localize 'SKSK.Models.Remove'}}">
            <i class="fas fa-trash"></i>
          </a>
        </div>

        <div class="grid grid-2col">
          <div class="grid-span-1">
            <label class="resource-label">{{localize 'SKSK.Models.FlatBonus'}}</label>
            <input type="text" name="armorModels.{{entry.index}}.flatBonus" value="{{entry.model.flatBonus}}"
              data-dtype="Number" />
          </div>
          <div class="grid-span-1">
            <label class="resource-label" title="{{localize 'SKSK.ModelProperty.Hardened.Hint'}}">
              {{localize 'SKSK.Models.HardenedValue'}}
            </label>
            <input type="text" name="armorModels.{{entry.index}}.hardenedValue" value="{{entry.model.hardenedValue}}"
              data-dtype="Number" />
          </div>
        </div>

        <label class="resource-label">{{localize 'SKSK.Models.Attributes'}}</label>
        <div class="grid grid-4col model-checkbox-grid">
          {{#each ../../attributeChoices as |label key|}}
          <label class="casting-method-option">
            <input type="checkbox" name="armorModels.{{entry.index}}.attributes.{{key}}"
              {{checked (includes entry.model.attributes key)}} />
            {{localize label}}
          </label>
          {{/each}}
        </div>

        <details class="model-properties-details" data-sync="armor-model-properties-{{entry.index}}">
          <summary class="resource-label">{{localize 'SKSK.Models.Properties'}}</summary>
          <div class="grid grid-3col model-checkbox-grid">
            {{#each (lookup ../../armorPropertyChoicesByType t.id) as |def key|}}
            <div class="model-property-option">
              <label class="casting-method-option" title="{{localize def.hint}}">
                <input type="checkbox" name="armorModels.{{entry.index}}.properties.{{key}}"
                  {{checked (includes entry.model.properties key)}} />
                {{localize def.label}}
              </label>
              {{#if def.hasRequirement}}
              <input type="text" class="model-requirement-input"
                name="armorModels.{{entry.index}}.{{concat key 'Requirement'}}"
                value="{{lookup entry.model (concat key 'Requirement')}}" data-dtype="Number"
                title="{{localize 'SKSK.Models.Requirement'}}" placeholder="{{localize 'SKSK.Models.Requirement'}}" />
              {{/if}}
            </div>
            {{/each}}
          </div>
        </details>
      </li>
      {{else}}
      <li class="item flexrow">
        <div class="item-name">{{localize 'SKSK.Models.None'}}</div>
      </li>
      {{/each}}
    </ol>
  </section>
  {{/each}}

</section>

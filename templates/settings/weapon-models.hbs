<section class="tab {{tab.cssClass}}" data-group="primary" data-tab="weaponModels">

  <nav class="sheet-tabs tabs weapon-model-type-tabs" data-group="weaponModelTypes">
    {{#each weaponModelTypeTabs as |t|}}
    <a class="{{t.cssClass}}" data-action="tab" data-group="weaponModelTypes" data-tab="{{t.id}}">
      <label>{{localize t.label}}</label>
    </a>
    {{/each}}
  </nav>

  {{#each weaponModelTypeTabs as |t|}}
  <section class="tab" data-group="weaponModelTypes" data-tab="{{t.id}}">
    <ol class="items-list">
      <li class="item flexrow items-header">
        <div class="item-name">{{localize t.label}}</div>
        <div class="item-controls">
          <a class="item-control" data-action="addWeaponModel" data-weapon-type="{{t.id}}"
            title="{{localize 'SKSK.Models.Add'}}">
            <i class="fas fa-plus"></i>
          </a>
        </div>
      </li>
      {{#each (lookup ../weaponModelsByType t.id) as |entry|}}
      <li class="item model-entry">
        <details class="settings-entry-details" data-sync="weapon-model-entry-{{entry.index}}" open>
          <summary class="settings-entry-summary">
            <i class="fas fa-chevron-right settings-entry-chevron"></i>
            <input type="text" name="weaponModels.{{entry.index}}.name" value="{{entry.model.name}}"
              class="settings-entry-name" placeholder="{{localize 'SKSK.Models.Name'}}" />
            <a class="item-control item-delete" data-action="removeWeaponModel" data-index="{{entry.index}}"
              title="{{localize 'SKSK.Models.Remove'}}">
              <i class="fas fa-trash"></i>
            </a>
          </summary>
          <div class="settings-entry-body flexcol">
            {{#if (includes ../../rangedWeaponTypes t.id)}}
            <div class="grid grid-3col">
              <div class="grid-span-1">
                <label class="resource-label">{{localize 'SKSK.Models.Kind'}}</label>
                <select name="weaponModels.{{entry.index}}.kind">
                  <option value="weapon" {{#unless (eq entry.model.kind "ammunition")}}selected{{/unless}}>
                    {{localize 'SKSK.Models.KindWeapon'}}
                  </option>
                  <option value="ammunition" {{#if (eq entry.model.kind "ammunition")}}selected{{/if}}>
                    {{localize 'SKSK.Models.KindAmmunition'}}
                  </option>
                </select>
              </div>
            </div>
            {{/if}}
            <div class="grid grid-4col">
              <div class="grid-span-1">
                <label class="resource-label">{{localize 'SKSK.Models.DiceFormula'}}</label>
                <input type="text" name="weaponModels.{{entry.index}}.diceFormula" value="{{entry.model.diceFormula}}"
                  placeholder="e.g. 1d4" />
              </div>
              <div class="grid-span-1">
                <label class="resource-label">{{localize 'SKSK.Models.FlatBonus'}}</label>
                <input type="text" name="weaponModels.{{entry.index}}.flatBonus" value="{{entry.model.flatBonus}}"
                  data-dtype="Number" />
              </div>
              <div class="grid-span-1">
                <label class="resource-label">{{localize 'SKSK.Models.DamageType'}}</label>
                <select name="weaponModels.{{entry.index}}.damageType">
                  {{#if (includes ../../rangedWeaponTypes t.id)}}
                  {{selectOptions ../../rangedDamageTypeChoices selected=entry.model.damageType localize=true}}
                  {{else}}
                  {{selectOptions ../../damageTypeChoices selected=entry.model.damageType localize=true}}
                  {{/if}}
                </select>
              </div>
              <div class="grid-span-1">
                <label class="resource-label">{{localize 'SKSK.Models.DurabilityMultiplier'}}</label>
                <input type="text" name="weaponModels.{{entry.index}}.durabilityMultiplier"
                  value="{{entry.model.durabilityMultiplier}}" data-dtype="Number" placeholder="1" />
              </div>
            </div>

            <label class="resource-label">{{localize 'SKSK.Models.Attributes'}}</label>
            <div class="grid grid-4col model-checkbox-grid">
              {{#each ../../attributeChoices as |label key|}}
              <label class="casting-method-option">
                <input type="checkbox" name="weaponModels.{{entry.index}}.attributes.{{key}}"
                  {{checked (includes entry.model.attributes key)}} />
                {{localize label}}
              </label>
              {{/each}}
            </div>

            <details class="model-properties-details" data-sync="weapon-model-properties-{{entry.index}}">
              <summary class="resource-label">{{localize 'SKSK.Models.Properties'}}</summary>
              <div class="grid grid-3col model-checkbox-grid">
                {{#each ../../weaponPropertyChoices as |def key|}}
                <div class="model-property-option">
                  <label class="casting-method-option" title="{{localize def.hint}}">
                    <input type="checkbox" name="weaponModels.{{entry.index}}.properties.{{key}}"
                      {{checked (includes entry.model.properties key)}} />
                    {{localize def.label}}
                  </label>
                  {{#if def.hasRequirement}}
                  <input type="text" class="model-requirement-input"
                    name="weaponModels.{{entry.index}}.{{concat key 'Requirement'}}"
                    value="{{lookup entry.model (concat key 'Requirement')}}" data-dtype="Number"
                    title="{{localize 'SKSK.Models.Requirement'}}" placeholder="{{localize 'SKSK.Models.Requirement'}}" />
                  {{/if}}
                  {{#if def.hasRange}}
                  <input type="text" class="model-requirement-input"
                    name="weaponModels.{{entry.index}}.{{concat key 'Range'}}"
                    value="{{lookup entry.model (concat key 'Range')}}" data-dtype="Number"
                    title="{{localize 'SKSK.Models.Range'}}" placeholder="{{localize 'SKSK.Models.Range'}}" />
                  {{/if}}
                  {{#if def.hasApCost}}
                  <input type="text" class="model-requirement-input"
                    name="weaponModels.{{entry.index}}.{{concat key 'ApCost'}}"
                    value="{{lookup entry.model (concat key 'ApCost')}}" data-dtype="Number"
                    title="{{localize 'SKSK.Models.ApCost'}}" placeholder="{{localize 'SKSK.Models.ApCost'}}" />
                  {{/if}}
                  {{#if def.hasMagazineSize}}
                  <input type="text" class="model-requirement-input"
                    name="weaponModels.{{entry.index}}.{{concat key 'MagazineSize'}}"
                    value="{{lookup entry.model (concat key 'MagazineSize')}}" data-dtype="Number"
                    title="{{localize 'SKSK.Models.MagazineSize'}}" placeholder="{{localize 'SKSK.Models.MagazineSize'}}" />
                  {{/if}}
                </div>
                {{/each}}
              </div>
            </details>
          </div>
        </details>
      </li>
      {{else}}
      <li class="item flexrow">
        <div class="item-name">{{localize 'SKSK.Models.None'}}</div>
      </li>
      {{/each}}
    </ol>
  </section>
  {{/each}}

</section>

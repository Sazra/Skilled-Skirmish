<div class="sksk-settings-export-import">
  <p class="hint">{{localize 'SKSK.Settings.ExportImport.Hint'}}</p>

  <div class="resource">
    <button type="button" data-action="exportSettings">
      <i class="fas fa-file-export"></i> {{localize 'SKSK.Settings.ExportImport.Export'}}
    </button>
  </div>

  <div class="resource">
    <button type="button" data-action="importSettings">
      <i class="fas fa-file-import"></i> {{localize 'SKSK.Settings.ExportImport.Import'}}
    </button>
    <p class="hint">{{localize 'SKSK.Settings.ExportImport.ImportHint'}}</p>
  </div>
</div>
